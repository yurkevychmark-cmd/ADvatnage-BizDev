{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/buyers/add/?$",
			"dest": "_render"
		},
		{
			"src": "^/buyers/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/buyers/?$",
			"dest": "_render"
		},
		{
			"src": "^/calculator/?$",
			"dest": "_render"
		},
		{
			"src": "^/deals/?$",
			"dest": "_render"
		},
		{
			"src": "^/matchmaking/?$",
			"dest": "_render"
		},
		{
			"src": "^/operators/add/?$",
			"dest": "_render"
		},
		{
			"src": "^/operators/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/operators/?$",
			"dest": "_render"
		},
		{
			"src": "^/pipeline/?$",
			"dest": "_render"
		},
		{
			"src": "^/projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}