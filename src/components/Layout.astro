---
import Nav from './Nav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ADvantage BizDev</title>
  </head>
  <body class="bg-surface text-gray-100 min-h-screen flex">
    <Nav currentPath={Astro.url.pathname} />
    <main class="flex-1 ml-60 p-8">
      <slot />
    </main>
  </body>
</html>
