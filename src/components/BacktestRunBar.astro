---
// Кнопка «Run backtest» і стан останнього прогону автоматичного порівняння (таск cfb5898d).
import { supabase } from '../lib/supabase';
import { runLabel } from '../lib/backtest';
import { apiRunsEnabled } from '../lib/agent/llm';

const { data: last } = await (supabase as any).from('backtest_runs').select('*').order('started_at', { ascending: false }).limit(1);
const r = last?.[0] ?? null;
const running = r?.status === 'running';
const viaApi = apiRunsEnabled();
---

<div class="flex flex-wrap items-center gap-3 text-xs" id="bt-runbar">
  {r && (
    <span class="text-gray-500">
      {running ? <span class="text-amber-300">Running {runLabel(r.id)}: {r.done}/{r.total || '…'}</span>
        : r.status === 'failed' ? <span class="text-danger">Last run failed{r.error ? `: ${r.error}` : ''}</span>
        : <span>Last run {runLabel(r.id)} · {r.done}/{r.total}{r.error ? ` · ${r.error}` : ''}</span>}
      <span class="text-gray-600"> · drafts {r.drafter_model}, judged by {r.judge_model}</span>
    </span>
  )}
  {!viaApi && <span class="text-gray-500">New runs go from the chat «Dev - BLACK ORACLE #1» (subscription, no API spend).</span>}
  {viaApi && <button id="bt-run" disabled={running} class="px-3 py-1.5 rounded-md border border-accent text-gray-100 hover:bg-accent/10 disabled:opacity-40 disabled:cursor-not-allowed">
    {running ? 'Running…' : 'Run backtest'}
  </button>}
  <span id="bt-run-msg" class="text-gray-500"></span>
</div>

<script is:inline define:vars={{ running }}>
  (function () {
    var b = document.getElementById('bt-run'), m = document.getElementById('bt-run-msg');
    if (running) setTimeout(function () { location.reload(); }, 15000);
    if (!b) return;
    b.addEventListener('click', function () {
      b.disabled = true; m.textContent = 'Starting…';
      fetch('/api/backtest-run', { method: 'POST' })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok) { m.textContent = res.j.error || 'Could not start'; b.disabled = false; return; }
          location.href = '/backtest?run=' + encodeURIComponent(res.j.id);
        })
        .catch(function () { m.textContent = 'No connection. Try again.'; b.disabled = false; });
    });
  })();
</script>
