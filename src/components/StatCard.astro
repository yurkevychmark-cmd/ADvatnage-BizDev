---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
}

const { label, value, sub } = Astro.props;
---

<div class="bg-card rounded-xl p-6 border border-gray-800">
  <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">{label}</p>
  <p class="text-2xl font-bold">{value}</p>
  {sub && <p class="text-xs text-gray-500 mt-1">{sub}</p>}
</div>
