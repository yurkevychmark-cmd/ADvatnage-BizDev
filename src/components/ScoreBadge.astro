---
interface Props {
  score: number;
}

const { score } = Astro.props;

const color = score >= 60 ? 'text-success bg-success/15 border-success/30'
            : score >= 30 ? 'text-warning bg-warning/15 border-warning/30'
            : 'text-danger bg-danger/15 border-danger/30';
---

<span class={`inline-block text-xs font-bold px-2.5 py-1 rounded border ${color}`}>
  {score}%
</span>
