---
// Оболонка сторінок без входу (вхід, запрошення): без навігації і без жодних даних.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | ADvantage BizDev</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body {
        background-color: #070909;
        background-image:
          radial-gradient(ellipse 80% 50% at 20% -10%, rgba(225,29,72,0.07) 0%, transparent 60%),
          radial-gradient(ellipse 60% 40% at 80% 110%, rgba(225,29,72,0.05) 0%, transparent 60%);
        background-attachment: fixed;
      }
    </style>
  </head>
  <body class="text-gray-100 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
      <div class="flex items-center justify-center gap-2.5 mb-8">
        <div class="w-8 h-8 bg-accent rounded-md flex items-center justify-center shrink-0">
          <span class="text-white font-black text-xs leading-none">AD</span>
        </div>
        <span class="text-white font-black text-xl tracking-tight">vantage</span>
        <span class="text-gray-600 text-sm ml-1">BizDev</span>
      </div>
      <div class="bg-card border border-border rounded-xl p-6 shadow-2xl">
        <slot />
      </div>
    </div>
  </body>
</html>
