---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Dashboard', icon: '◫' },
  { href: '/buyers', label: 'Buyers', icon: '⊕' },
  { href: '/operators', label: 'Operators', icon: '⊛' },
  { href: '/matchmaking', label: 'Matchmaking', icon: '⇋' },
  { href: '/pipeline', label: 'Pipeline', icon: '▤' },
  { href: '/projects', label: 'Projects', icon: '◈' },
  { href: '/calculator', label: 'Calculator', icon: '∑' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<aside class="fixed left-0 top-0 h-screen w-60 bg-card border-r border-border flex flex-col" style="box-shadow: 4px 0 24px rgba(225,29,72,0.06);">
  <div class="p-6 border-b border-border flex items-center gap-3">
    <img src="/logo.png" alt="ADvantage" class="h-7 brightness-0 invert" id="nav-logo" />
    <div id="logo-fallback">
      <span class="text-accent font-black text-lg tracking-tight">AD</span><span class="text-white font-black text-lg tracking-tight">VANTAGE</span>
    </div>
  </div>
  <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
    {links.map(link => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-all ${
          isActive(link.href)
            ? 'bg-accent/15 text-accent font-medium border border-accent/25'
            : 'text-gray-400 hover:text-gray-100 hover:bg-white/5 border border-transparent'
        }`}
      >
        <span class="text-base">{link.icon}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="p-4 border-t border-border">
    <p class="text-xs text-gray-700">Internal Tool v1.0</p>
  </div>
</aside>

<script>
  const img = document.getElementById('nav-logo') as HTMLImageElement;
  const fallback = document.getElementById('logo-fallback');
  if (img && fallback) {
    if (img.complete && img.naturalWidth > 0) {
      fallback.style.display = 'none';
    } else {
      img.onload = () => { fallback!.style.display = 'none'; };
      img.onerror = () => { img.style.display = 'none'; };
    }
  }
</script>
