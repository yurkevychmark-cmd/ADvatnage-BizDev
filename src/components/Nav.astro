---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Dashboard', icon: '◫' },
  { href: '/buyers', label: 'Buyers', icon: '⊕' },
  { href: '/operators', label: 'Operators', icon: '⊛' },
  { href: '/matchmaking', label: 'Matchmaking', icon: '⇋' },
  { href: '/calculator', label: 'Calculator', icon: '∑' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<aside class="fixed left-0 top-0 h-screen w-60 bg-card border-r border-gray-800 flex flex-col">
  <div class="p-6 border-b border-gray-800">
    <h1 class="text-lg font-bold text-accent">ADvantage</h1>
    <p class="text-xs text-gray-500">BizDev Platform</p>
  </div>
  <nav class="flex-1 p-4 space-y-1">
    {links.map(link => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors ${
          isActive(link.href)
            ? 'bg-accent/20 text-accent font-medium'
            : 'text-gray-400 hover:text-gray-100 hover:bg-gray-800/50'
        }`}
      >
        <span class="text-base">{link.icon}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="p-4 border-t border-gray-800">
    <p class="text-xs text-gray-600">Internal Tool v1.0</p>
  </div>
</aside>
