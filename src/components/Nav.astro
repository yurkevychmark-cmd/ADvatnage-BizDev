---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/',          label: 'Dashboard', icon: '◫' },
  { href: '/operators', label: 'Operators', icon: '⊛' },
  { href: '/deals',     label: 'Deals',     icon: '⇋' },
  { href: '/tasks',     label: 'Tasks',     icon: '✓' },
  { href: '/buyers',    label: 'Buyers',    icon: '⊕' },
  { href: '/reports',   label: 'Reports',   icon: '📊' },
  { href: '/log',       label: 'Journey',   icon: '◷' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- ── Mobile top bar ──────────────────────────────────────────────────── -->
<div class="md:hidden fixed top-0 left-0 right-0 z-50 bg-card border-b border-border flex items-center justify-between px-4 h-14">
  <div class="flex items-center gap-2">
    <div class="w-7 h-7 bg-accent rounded-md flex items-center justify-center shrink-0">
      <span class="text-white font-black text-xs leading-none">AD</span>
    </div>
    <span class="text-white font-black text-lg tracking-tight">vantage</span>
  </div>
  <button id="mobile-menu-btn" class="text-gray-400 hover:text-white p-2 transition-colors" aria-label="Open menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</div>

<!-- ── Mobile drawer overlay ──────────────────────────────────────────── -->
<div id="mobile-overlay" class="md:hidden fixed inset-0 z-40 bg-black/60 hidden" aria-hidden="true"></div>

<!-- ── Mobile drawer ──────────────────────────────────────────────────── -->
<div id="mobile-drawer" class="md:hidden fixed top-0 left-0 h-full w-64 z-50 bg-card border-r border-border flex flex-col -translate-x-full transition-transform duration-300">
  <div class="p-5 border-b border-border flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 bg-accent rounded-md flex items-center justify-center shrink-0">
        <span class="text-white font-black text-xs leading-none">AD</span>
      </div>
      <span class="text-white font-black text-lg tracking-tight">vantage</span>
    </div>
    <button id="mobile-close-btn" class="text-gray-600 hover:text-gray-300 transition-colors p-1">✕</button>
  </div>
  <nav class="flex-1 p-3 space-y-0.5 overflow-y-auto">
    {links.map(link => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all ${
          isActive(link.href)
            ? 'bg-accent/15 text-accent font-medium border border-accent/25'
            : 'text-gray-400 hover:text-gray-100 hover:bg-white/5 border border-transparent'
        }`}
      >
        <span class="text-base">{link.icon}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="p-4 border-t border-border">
    <p class="text-xs text-gray-700">Internal Tool v1.0</p>
  </div>
</div>

<!-- ── Desktop sidebar ─────────────────────────────────────────────────── -->
<aside class="hidden md:flex fixed left-0 top-0 h-screen w-56 bg-card border-r border-border flex-col" style="box-shadow: 4px 0 24px rgba(225,29,72,0.06);">
  <div class="p-5 border-b border-border flex items-center gap-2.5">
    <div class="w-7 h-7 bg-accent rounded-md flex items-center justify-center shrink-0">
      <span class="text-white font-black text-xs leading-none">AD</span>
    </div>
    <span class="text-white font-black text-lg tracking-tight">vantage</span>
  </div>
  <nav class="flex-1 p-3 space-y-0.5 overflow-y-auto">
    {links.map(link => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all ${
          isActive(link.href)
            ? 'bg-accent/15 text-accent font-medium border border-accent/25'
            : 'text-gray-400 hover:text-gray-100 hover:bg-white/5 border border-transparent'
        }`}
      >
        <span class="text-base">{link.icon}</span>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="p-4 border-t border-border">
    <p class="text-xs text-gray-700">Internal Tool v1.0</p>
  </div>
</aside>

<script>
  const btn     = document.getElementById('mobile-menu-btn');
  const closeBtn= document.getElementById('mobile-close-btn');
  const drawer  = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('mobile-overlay');

  function openDrawer() {
    drawer?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
