---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: operators } = await supabase
  .from('operators')
  .select('*')
  .order('created_at', { ascending: false });

const operatorsJson = JSON.stringify(operators ?? []);

const dealTypeBadge: Record<string, string> = {
  CPA:      'bg-success/15 text-success border-success/25',
  RevShare: 'bg-accent/15 text-accent border-accent/25',
  Spend:    'bg-warning/15 text-warning border-warning/25',
  Hybrid:   'bg-blue-500/15 text-blue-400 border-blue-500/25',
};
---

<Layout title="Operators">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Operators</h1>
      <p class="text-gray-500 text-sm mt-1">Advertisers and casinos available for partnerships</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="export-csv" class="text-sm text-gray-400 hover:text-gray-200 border border-border px-4 py-2 rounded-lg bg-card-2 transition-colors">
        ↓ Export CSV
      </button>
      <a href="/operators/add" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
        + Add Operator
      </a>
    </div>
  </div>

  <!-- Search bar -->
  <div class="flex gap-3 mb-4">
    <input id="search" type="text" placeholder="Search by name, brand or GEO…"
      class="flex-1 bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
    <select id="filter-deal" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">All deal types</option>
      <option>CPA</option>
      <option>RevShare</option>
      <option>Spend</option>
      <option>Hybrid</option>
    </select>
    <span id="count" class="self-center text-xs text-gray-600 font-mono"></span>
  </div>

  {(!operators || operators.length === 0) ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500">No operators yet.</p>
      <a href="/operators/add" class="text-accent hover:underline text-sm mt-2 inline-block">Add your first operator</a>
    </div>
  ) : (
    <div class="bg-card rounded-xl border border-border overflow-hidden">
      <!-- Table header -->
      <div class="grid grid-cols-[2fr_1.5fr_1.5fr_1fr_1fr_1.5fr_1fr_auto] gap-4 px-5 py-3 border-b border-border bg-card-2 text-xs text-gray-500 uppercase tracking-wide font-medium">
        <div>Name / Brand</div>
        <div>Contact</div>
        <div>GEOs</div>
        <div>Deal Type</div>
        <div>Terms</div>
        <div>Budget / mo</div>
        <div>Rating</div>
        <div></div>
      </div>

      <!-- Table rows -->
      <div id="op-table">
        {(operators as any[]).map(op => {
          const geos = (op.target_geos ?? []);
          const dtype = op.deal_type ?? 'CPA';
          const terms = dtype === 'CPA'
            ? (op.cpa_value ? `$${op.cpa_value}/conv` : '—')
            : dtype === 'Spend'
              ? (op.spend_pct ?? op.revshare_pct ? `${op.spend_pct ?? op.revshare_pct}%` : '—')
              : dtype === 'Hybrid'
                ? [op.cpa_value ? `$${op.cpa_value}` : null, op.revshare_pct ? `${op.revshare_pct}%` : null].filter(Boolean).join(' + ') || '—'
                : (op.revshare_pct ? `${op.revshare_pct}%` : '—');

          return (
            <div
              class="op-row grid grid-cols-[2fr_1.5fr_1.5fr_1fr_1fr_1.5fr_1fr_auto] gap-4 px-5 py-4 border-b border-border last:border-0 hover:bg-card-2/50 transition-colors items-center cursor-pointer"
              data-name={`${op.name ?? ''} ${op.brand ?? ''}`.toLowerCase()}
              data-deal={(dtype).toLowerCase()}
              data-geo={(geos).join(' ').toLowerCase()}
              onclick={`window.location='/operators/${op.id}'`}
            >
              <!-- Name / Brand -->
              <div class="min-w-0">
                <p class="font-medium text-sm truncate">{op.name ?? op.brand_name ?? '—'}</p>
                {op.brand && op.brand !== op.name && (
                  <p class="text-xs text-gray-600 truncate">{op.brand}</p>
                )}
              </div>

              <!-- Contact -->
              <div class="min-w-0">
                {op.contact ? (
                  <span class="text-xs text-accent font-mono truncate block">{op.contact}</span>
                ) : (
                  <span class="text-xs text-gray-700 italic">—</span>
                )}
              </div>

              <!-- GEOs -->
              <div class="flex flex-wrap gap-1">
                {geos.slice(0, 4).map((g: string) => (
                  <span class="text-xs bg-card-2 border border-border px-1.5 py-0.5 rounded text-gray-400 font-mono">{g}</span>
                ))}
                {geos.length > 4 && <span class="text-xs text-gray-600">+{geos.length - 4}</span>}
                {geos.length === 0 && <span class="text-xs text-gray-700 italic">—</span>}
              </div>

              <!-- Deal Type -->
              <div>
                <span class={`text-xs px-2 py-0.5 rounded border font-medium ${dealTypeBadge[dtype] ?? 'bg-gray-700/40 text-gray-400 border-gray-600'}`}>
                  {dtype}
                </span>
              </div>

              <!-- Terms -->
              <div class="font-mono text-sm text-gray-300">{terms}</div>

              <!-- Budget -->
              <div class="text-sm text-gray-400 font-mono">
                {op.budget_min != null
                  ? `$${Number(op.budget_min).toLocaleString()} — $${Number(op.budget_max).toLocaleString()}`
                  : '—'}
              </div>

              <!-- Rating -->
              <div>
                {op.rating != null ? (
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded border ${
                    op.rating >= 8 ? 'bg-success/15 text-success border-success/25' :
                    op.rating >= 5 ? 'bg-warning/15 text-warning border-warning/25' :
                    'bg-danger/15 text-danger border-danger/25'
                  }`}>{op.rating}/10</span>
                ) : (
                  <span class="text-gray-700 text-xs">—</span>
                )}
              </div>

              <!-- Edit arrow -->
              <div class="text-gray-600 text-sm">›</div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <div id="empty-filter" class="hidden bg-card rounded-xl border border-border p-12 text-center mt-2">
    <p class="text-gray-500">No operators match your search.</p>
  </div>
</Layout>

<script define:vars={{ operatorsJson }}>
  const operators = JSON.parse(operatorsJson);
  const rows = document.querySelectorAll('.op-row');
  const countEl = document.getElementById('count');
  const emptyFilter = document.getElementById('empty-filter');

  function applyFilters() {
    const search = document.getElementById('search').value.toLowerCase();
    const deal = document.getElementById('filter-deal').value.toLowerCase();
    let visible = 0;
    rows.forEach(row => {
      const name = row.dataset.name ?? '';
      const rowDeal = row.dataset.deal ?? '';
      const geo = row.dataset.geo ?? '';
      const ok = (!search || name.includes(search) || geo.includes(search)) &&
                 (!deal || rowDeal === deal);
      row.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    countEl.textContent = `${visible} of ${rows.length}`;
    emptyFilter.classList.toggle('hidden', visible > 0);
  }

  ['search', 'filter-deal'].forEach(id =>
    document.getElementById(id)?.addEventListener('input', applyFilters)
  );
  applyFilters();

  document.getElementById('export-csv')?.addEventListener('click', () => {
    const headers = ['Name','Brand','GEOs','Deal Type','CPA Value','RevShare %','Spend %','Budget Min','Budget Max','Rating','Notes'];
    const rows = operators.map(o => [
      o.name ?? '', o.brand ?? '',
      (o.target_geos ?? []).join(';'),
      o.deal_type ?? '',
      o.cpa_value ?? '', o.revshare_pct ?? '', o.spend_pct ?? '',
      o.budget_min ?? '', o.budget_max ?? '',
      o.rating ?? '', (o.notes ?? '').replace(/\n/g, ' '),
    ]);
    const csv = [headers, ...rows].map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = 'operators.csv';
    a.click();
  });
</script>
