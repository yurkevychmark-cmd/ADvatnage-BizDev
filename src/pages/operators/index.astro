---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: operators } = await supabase
  .from('operators')
  .select('*, deals:projects(pipeline_stage)')
  .order('sort_order', { ascending: true, nullsFirst: false })
  .order('created_at', { ascending: false });

// Stage priority: most "active" stage wins for display
const stagePriority = ['active', 'trial', 'negotiation', 'new', 'completed', 'no_deal'];

function getPrimaryStage(deals: any[]): string | null {
  if (!deals || deals.length === 0) return null;
  for (const s of stagePriority) {
    if (deals.some((d: any) => d.pipeline_stage === s)) return s;
  }
  return null;
}

const stageLabel: Record<string, string> = {
  new: 'New',
  negotiation: 'Negotiation',
  trial: 'Trial',
  active: 'Retention',
  completed: 'Completed',
  no_deal: 'No Deal',
};

const stageBorderColor: Record<string, string> = {
  active:      'border-l-success',
  trial:       'border-l-purple-500',
  negotiation: 'border-l-warning',
  new:         'border-l-blue-500',
  completed:   'border-l-blue-400',
  no_deal:     'border-l-danger',
};

const stagePillColor: Record<string, string> = {
  active:      'bg-success/15 text-success border-success/25',
  trial:       'bg-purple-500/15 text-purple-400 border-purple-500/25',
  negotiation: 'bg-warning/15 text-warning border-warning/25',
  new:         'bg-blue-500/15 text-blue-400 border-blue-500/25',
  completed:   'bg-blue-400/10 text-blue-300 border-blue-400/20',
  no_deal:     'bg-danger/15 text-danger border-danger/25',
};

const operatorsJson = JSON.stringify(operators ?? []);

// Open tasks per operator
const { data: openTasks } = await supabase
  .from('tasks')
  .select('entity_id')
  .eq('entity_type', 'operator')
  .neq('status', 'done');

const taskCountByOp: Record<string, number> = {};
(openTasks ?? []).forEach((t: any) => {
  if (t.entity_id) taskCountByOp[t.entity_id] = (taskCountByOp[t.entity_id] ?? 0) + 1;
});

const dealTypeBadge: Record<string, string> = {
  CPA:      'bg-success/15 text-success border-success/25',
  RevShare: 'bg-accent/15 text-accent border-accent/25',
  Spend:    'bg-warning/15 text-warning border-warning/25',
  Hybrid:   'bg-blue-500/15 text-blue-400 border-blue-500/25',
};

function getDomain(url: string): string {
  try { return new URL(url).hostname.replace('www.', ''); }
  catch { return url; }
}
---

<Layout title="Operators">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Operators</h1>
      <p class="text-gray-500 text-sm mt-1">Advertisers and casinos available for partnerships</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="export-csv" class="text-sm text-gray-400 hover:text-gray-200 border border-border px-4 py-2 rounded-lg bg-card-2 transition-colors">
        ↓ Export CSV
      </button>
      <a href="/operators/add" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
        + Add Operator
      </a>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex gap-3 mb-4 flex-wrap">
    <input id="search" type="text" placeholder="Search by name, brand or GEO…"
      class="flex-1 min-w-48 bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
    <select id="filter-deal" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">All deal types</option>
      <option>CPA</option>
      <option>RevShare</option>
      <option>Spend</option>
      <option>Hybrid</option>
    </select>
    <select id="filter-traffic" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">All traffic</option>
      <option>Meta Ads</option>
      <option>InApp</option>
      <option>DSP</option>
      <option>Google Ads</option>
      <option>TikTok Ads</option>
    </select>
    <span id="count" class="self-center text-xs text-gray-600 font-mono"></span>
  </div>

  {(!operators || operators.length === 0) ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500">No operators yet.</p>
      <a href="/operators/add" class="text-accent hover:underline text-sm mt-2 inline-block">Add your first operator</a>
    </div>
  ) : (
    <div class="bg-card rounded-xl border border-border overflow-hidden" id="op-table">

      <!-- Header -->
      <div class="grid grid-cols-[1.5rem_2fr_1.2fr_1.2fr_0.8fr_0.8fr_0.8fr_auto] gap-4 px-5 py-3 border-b border-border bg-card-2 text-xs text-gray-500 uppercase tracking-wide font-medium">
        <div></div>
        <div>Name / Brand</div>
        <div>Contact</div>
        <div>GEOs</div>
        <div>Deal</div>
        <div>Terms</div>
        <div>Rating</div>
        <div></div>
      </div>

      <!-- Rows -->
      {(operators as any[]).map(op => {
        const geos: string[] = op.target_geos ?? [];
        const traffic: string[] = op.preferred_traffic ?? [];
        const links: string[] = op.links ?? [];
        const primaryStage = getPrimaryStage(op.deals ?? []);
        const dtype = op.deal_type ?? 'CPA';
        const terms = dtype === 'CPA'
          ? (op.cpa_value ? `$${op.cpa_value}/conv` : '—')
          : dtype === 'Spend'
            ? (op.spend_pct ? `${op.spend_pct}%` : '—')
            : dtype === 'Hybrid'
              ? [op.cpa_value ? `$${op.cpa_value}` : null, op.revshare_pct ? `${op.revshare_pct}%` : null].filter(Boolean).join('+') || '—'
              : (op.revshare_pct ? `${op.revshare_pct}%` : '—');
        const notes: string = op.notes ?? '';
        const hasDetails = traffic.length > 0 || geos.length > 0 || links.length > 0 || notes || op.budget_min != null;
        const openTaskCount = taskCountByOp[op.id] ?? 0;

        return (
          <div
            class={`op-row border-b border-border last:border-0 border-l-2 ${primaryStage ? stageBorderColor[primaryStage] : 'border-l-transparent'}`}
            draggable="true"
            data-id={op.id}
            data-name={`${op.name ?? ''} ${op.brand_name ?? ''}`.toLowerCase()}
            data-deal={dtype.toLowerCase()}
            data-traffic={traffic.join(' ').toLowerCase()}
            data-geo={geos.join(' ').toLowerCase()}
          >
            <!-- Main row -->
            <div class="grid grid-cols-[1.5rem_2fr_1.2fr_1.2fr_0.8fr_0.8fr_0.8fr_auto] gap-4 px-5 py-3.5 hover:bg-card-2/40 transition-colors items-center">

              <!-- Drag handle -->
              <div class="drag-handle text-gray-700 hover:text-gray-400 cursor-grab active:cursor-grabbing select-none text-base leading-none" title="Drag to reorder">⠿</div>

              <!-- Name + Traffic tags -->
              <div class="min-w-0">
                <a href={`/operators/${op.id}`} class="font-medium text-sm hover:text-accent transition-colors truncate block">{op.name ?? '—'}</a>
                {op.brand_name && op.brand_name !== op.name && (
                  <p class="text-xs text-gray-600 truncate">{op.brand_name}</p>
                )}
                <div class="flex flex-wrap gap-1 mt-1 items-center">
                  {traffic.map((t: string) => (
                    <span class="text-xs bg-card-2 border border-border/60 px-1.5 py-0.5 rounded text-gray-500 leading-none">{t}</span>
                  ))}
                  {primaryStage && (
                    <span class={`text-xs px-1.5 py-0.5 rounded border font-medium leading-none ${stagePillColor[primaryStage]}`}>
                      {stageLabel[primaryStage]}
                    </span>
                  )}
                </div>
                {openTaskCount > 0 && (
                  <a href="/tasks"
                    class="inline-flex items-center gap-1 mt-1.5 text-xs font-semibold px-2 py-0.5 rounded-md border bg-warning/20 text-warning border-warning/40 hover:bg-warning/30 transition-colors"
                    title={`${openTaskCount} open task${openTaskCount > 1 ? 's' : ''}`}
                    onclick="event.stopPropagation()">
                    📋 {openTaskCount} task{openTaskCount > 1 ? 's' : ''}
                  </a>
                )}
              </div>

              <!-- Contact (click to copy) -->
              <div class="min-w-0">
                {op.contact ? (
                  <button
                    class="text-xs text-accent font-mono truncate block hover:text-accent/70 cursor-pointer transition-colors text-left"
                    onclick={`event.stopPropagation();copyText('${op.contact}')`}
                    title="Click to copy"
                  >{op.contact}</button>
                ) : (
                  <span class="text-xs text-gray-700">—</span>
                )}
              </div>

              <!-- GEOs (compact, desktop only) -->
              <div class="hidden md:flex flex-wrap gap-1 items-center">
                {geos.slice(0, 4).map((g: string) => (
                  <span class="text-[10px] font-mono bg-card-2 border border-border/60 px-1 py-0.5 rounded text-gray-400 leading-none">{g}</span>
                ))}
                {geos.length > 4 && (
                  <span class="text-[10px] text-gray-600 font-mono leading-none">+{geos.length - 4}</span>
                )}
                {geos.length === 0 && <span class="text-xs text-gray-700">—</span>}
              </div>

              <!-- Deal type -->
              <div>
                <span class={`text-xs px-2 py-0.5 rounded border font-medium ${dealTypeBadge[dtype] ?? 'bg-gray-700/40 text-gray-400 border-gray-600'}`}>
                  {dtype}
                </span>
              </div>

              <!-- Terms -->
              <div class="font-mono text-sm text-gray-300">{terms}</div>

              <!-- Rating -->
              <div>
                {op.rating != null ? (
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded border ${
                    op.rating >= 8 ? 'bg-success/15 text-success border-success/25' :
                    op.rating >= 5 ? 'bg-warning/15 text-warning border-warning/25' :
                    'bg-danger/15 text-danger border-danger/25'
                  }`}>{op.rating}/10</span>
                ) : <span class="text-gray-700 text-xs">—</span>}
              </div>

              <!-- Expand toggle -->
              <button
                class="expand-btn text-gray-600 hover:text-gray-300 text-base transition-colors px-1 select-none"
                data-id={op.id}
                title="Show details"
              >⌄</button>
            </div>

            <!-- Expanded detail panel -->
            <div id={`op-expand-${op.id}`} class="hidden border-t border-border/50 bg-card-2/30 px-5 py-4">
              <div class="grid grid-cols-[1fr_1fr_1fr] gap-x-8 gap-y-4">

                <!-- Traffic types -->
                <div>
                  <p class="text-xs text-gray-600 uppercase tracking-wide mb-2">Traffic Sources</p>
                  {traffic.length > 0 ? (
                    <div class="flex flex-wrap gap-1.5">
                      {traffic.map(t => (
                        <span class="text-xs bg-card border border-border px-2 py-0.5 rounded-full text-gray-300">{t}</span>
                      ))}
                    </div>
                  ) : <span class="text-xs text-gray-700">—</span>}
                </div>

                <!-- GEOs -->
                <div>
                  <p class="text-xs text-gray-600 uppercase tracking-wide mb-2">GEOs</p>
                  {geos.length > 0 ? (
                    <div class="flex flex-wrap gap-1">
                      {geos.map(g => (
                        <span class="text-xs bg-card border border-border px-1.5 py-0.5 rounded text-gray-400 font-mono">{g}</span>
                      ))}
                    </div>
                  ) : <span class="text-xs text-gray-700">—</span>}
                </div>

                <!-- Budget -->
                <div>
                  <p class="text-xs text-gray-600 uppercase tracking-wide mb-2">Budget / mo</p>
                  <span class="text-sm text-gray-300 font-mono">
                    {op.budget_min != null
                      ? `$${Number(op.budget_min).toLocaleString()} — $${Number(op.budget_max).toLocaleString()}`
                      : '—'}
                  </span>
                </div>

                <!-- Links -->
                {links.length > 0 && (
                  <div>
                    <p class="text-xs text-gray-600 uppercase tracking-wide mb-2">Links</p>
                    <div class="flex flex-wrap gap-2">
                      {links.map(link => (
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          onclick="event.stopPropagation()"
                          class="inline-flex items-center gap-1 text-xs bg-card border border-border hover:border-accent/40 text-accent hover:text-accent/80 px-2 py-1 rounded-lg transition-colors"
                        >
                          <span>↗</span>
                          <span class="max-w-[120px] truncate">{getDomain(link)}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Notes -->
                {notes && (
                  <div class={links.length > 0 ? 'col-span-2' : 'col-span-3'}>
                    <p class="text-xs text-gray-600 uppercase tracking-wide mb-2">Notes</p>
                    <p class="text-sm text-gray-400 leading-relaxed notes-text" data-full={notes}>
                      {notes.length > 120 ? notes.slice(0, 120) + '…' : notes}
                    </p>
                    {notes.length > 120 && (
                      <button class="notes-toggle text-xs text-accent hover:text-accent/80 mt-1 transition-colors">Show more</button>
                    )}
                  </div>
                )}
              </div>

              <!-- Edit link -->
              <div class="mt-4 pt-3 border-t border-border/30 flex justify-end">
                <a href={`/operators/${op.id}`}
                  class="inline-flex items-center gap-1.5 text-xs font-medium bg-card-2 hover:bg-accent hover:text-white border border-border hover:border-accent text-gray-400 transition-all px-3 py-1.5 rounded-lg">
                  ✎ Edit operator
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <div id="empty-filter" class="hidden bg-card rounded-xl border border-border p-12 text-center mt-2">
    <p class="text-gray-500">No operators match your search.</p>
  </div>
</Layout>

<script define:vars={{ operatorsJson }}>
  const operators = JSON.parse(operatorsJson);
  const opTable = document.getElementById('op-table');
  const rows = () => [...document.querySelectorAll('.op-row')];
  const countEl = document.getElementById('count');
  const emptyFilter = document.getElementById('empty-filter');

  // ── Filters ───────────────────────────────────────────────────────────
  function applyFilters() {
    const search = document.getElementById('search').value.toLowerCase();
    const deal = document.getElementById('filter-deal').value.toLowerCase();
    const traffic = document.getElementById('filter-traffic').value.toLowerCase();
    let visible = 0;
    rows().forEach(row => {
      const name = row.dataset.name ?? '';
      const geo = row.dataset.geo ?? '';
      const rowDeal = row.dataset.deal ?? '';
      const rowTraffic = row.dataset.traffic ?? '';
      const ok =
        (!search || name.includes(search) || geo.includes(search)) &&
        (!deal || rowDeal === deal) &&
        (!traffic || rowTraffic.includes(traffic));
      row.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    countEl.textContent = `${visible} of ${rows().length}`;
    emptyFilter.classList.toggle('hidden', visible > 0);
  }

  ['search', 'filter-deal', 'filter-traffic'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', applyFilters);
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });
  applyFilters();

  // ── Expand / collapse ─────────────────────────────────────────────────
  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const panel = document.getElementById(`op-expand-${id}`);
      const open = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      btn.textContent = open ? '⌄' : '⌃';
    });
  });

  // ── Notes expand ──────────────────────────────────────────────────────
  document.querySelectorAll('.notes-toggle').forEach(btn => {
    let expanded = false;
    const p = btn.previousElementSibling;
    const full = p.dataset.full;
    btn.addEventListener('click', e => {
      e.stopPropagation();
      expanded = !expanded;
      p.textContent = expanded ? full : full.slice(0, 120) + '…';
      btn.textContent = expanded ? 'Show less' : 'Show more';
    });
  });

  // ── Drag and drop ─────────────────────────────────────────────────────
  let dragSrc = null;

  if (opTable) {
    opTable.addEventListener('dragstart', e => {
      const row = e.target.closest('.op-row');
      if (!row) return;
      dragSrc = row;
      row.style.opacity = '0.4';
      e.dataTransfer.effectAllowed = 'move';
    });

    opTable.addEventListener('dragend', () => {
      if (dragSrc) dragSrc.style.opacity = '';
      dragSrc = null;
      rows().forEach(r => r.classList.remove('bg-accent/5'));
    });

    opTable.addEventListener('dragover', e => {
      e.preventDefault();
      const row = e.target.closest('.op-row');
      rows().forEach(r => r.classList.remove('bg-accent/5'));
      if (row && row !== dragSrc) row.classList.add('bg-accent/5');
    });

    opTable.addEventListener('drop', e => {
      e.preventDefault();
      const target = e.target.closest('.op-row');
      if (!target || target === dragSrc || !dragSrc) return;
      rows().forEach(r => r.classList.remove('bg-accent/5'));
      const rect = target.getBoundingClientRect();
      opTable.insertBefore(dragSrc, e.clientY < rect.top + rect.height / 2 ? target : target.nextSibling);
      fetch('/api/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ table: 'operators', ids: rows().map(r => r.dataset.id).filter(Boolean) }),
      });
    });
  }

  // ── CSV export ────────────────────────────────────────────────────────
  document.getElementById('export-csv')?.addEventListener('click', () => {
    const headers = ['Name','Brand','Contact','GEOs','Traffic','Deal Type','CPA Value','RevShare %','Spend %','Budget Min','Budget Max','Rating','Links','Notes'];
    const csvRows = operators.map(o => [
      o.name ?? '', o.brand_name ?? '', o.contact ?? '',
      (o.target_geos ?? []).join(';'),
      (o.preferred_traffic ?? []).join(';'),
      o.deal_type ?? '', o.cpa_value ?? '', o.revshare_pct ?? '', o.spend_pct ?? '',
      o.budget_min ?? '', o.budget_max ?? '', o.rating ?? '',
      (o.links ?? []).join(';'),
      (o.notes ?? '').replace(/\n/g, ' '),
    ]);
    const csv = [headers, ...csvRows].map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = 'operators.csv';
    a.click();
  });
</script>
