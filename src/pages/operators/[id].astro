---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const { id } = Astro.params;
const trafficOptions = ['Meta Ads', 'InApp', 'DSP', 'Google Ads', 'TikTok Ads'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  if (action === 'delete') {
    await supabase.from('operators').delete().eq('id', id!);
    return Astro.redirect('/operators');
  }
  const geoRaw = (form.get('target_geos') as string) || '';
  const geo = geoRaw.split(',').map(g => g.trim().toUpperCase()).filter(Boolean);
  const traffic = trafficOptions.filter(t => form.get(`traffic_${t}`));
  const ratingRaw = form.get('rating') as string;
  const dealType = form.get('deal_type') as string;
  await supabase.from('operators').update({
    name: form.get('name') as string,
    brand: (form.get('brand') as string) || null,
    contact: (form.get('contact') as string) || null,
    payment_method: (form.get('payment_method') as string) || null,
    target_geos: geo,
    budget_min: Number(form.get('budget_min')) || 0,
    budget_max: Number(form.get('budget_max')) || 0,
    preferred_traffic: traffic,
    deal_type: dealType || 'CPA',
    cpa_value: Number(form.get('cpa_value')) || null,
    revshare_pct: Number(form.get('revshare_pct')) || null,
    spend_pct: Number(form.get('spend_pct')) || null,
    rating: ratingRaw ? Number(ratingRaw) : null,
    notes: (form.get('notes') as string) || null,
  }).eq('id', id!);
  return Astro.redirect('/operators');
}

const { data: operator } = await supabase.from('operators').select('*').eq('id', id!).single();
if (!operator) return Astro.redirect('/operators');
const op = operator as any;

const inputCls = "w-full bg-card-2 border border-border rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none placeholder-gray-600 transition-colors";
---

<Layout title={`Edit ${op.name}`}>
  <div class="mb-8">
    <a href="/operators" class="text-gray-600 hover:text-gray-300 text-sm transition-colors">&larr; Back to Operators</a>
    <h1 class="text-2xl font-bold mt-2">{op.name}</h1>
    {op.brand && <p class="text-gray-500 text-sm">{op.brand}</p>}
  </div>

  <form method="POST" class="bg-card rounded-xl border border-border p-6 max-w-2xl space-y-5">

    <!-- Name + Brand -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Name *</label>
        <input type="text" name="name" required value={op.name} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Brand</label>
        <input type="text" name="brand" value={op.brand || ''} class={inputCls} />
      </div>
    </div>

    <!-- Contact + Payment Method -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Contact <span class="text-gray-600">(TG / WhatsApp)</span></label>
        <input type="text" name="contact" value={op.contact || ''} placeholder="@username or +380…" class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Payment Method</label>
        <select name="payment_method" class={inputCls}>
          <option value="">— Select —</option>
          <option value="Bank Transfer" selected={op.payment_method === 'Bank Transfer'}>Bank Transfer</option>
          <option value="Crypto" selected={op.payment_method === 'Crypto'}>Crypto</option>
          <option value="Bank Transfer + Crypto" selected={op.payment_method === 'Bank Transfer + Crypto'}>Bank Transfer + Crypto</option>
        </select>
      </div>
    </div>

    <!-- Target GEOs -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Target GEOs <span class="text-gray-600">(comma-separated)</span></label>
      <input type="text" name="target_geos" value={(op.target_geos ?? []).join(', ')} class={inputCls} />
    </div>

    <!-- Budget -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Min (USD/mo)</label>
        <input type="number" name="budget_min" step="100" min="0" value={op.budget_min} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Max (USD/mo)</label>
        <input type="number" name="budget_max" step="100" min="0" value={op.budget_max} class={inputCls} />
      </div>
    </div>

    <!-- Traffic Types -->
    <div>
      <label class="block text-sm text-gray-400 mb-2">Preferred Traffic Types</label>
      <div class="flex flex-wrap gap-3">
        {trafficOptions.map(t => (
          <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer group">
            <input type="checkbox" name={`traffic_${t}`} checked={(op.preferred_traffic ?? []).includes(t)}
              class="rounded bg-card-2 border-border text-accent focus:ring-accent focus:ring-offset-0" />
            <span class="group-hover:text-accent transition-colors">{t}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Deal Type + Dynamic Value -->
    <div>
      <label class="block text-sm text-gray-400 mb-2">Deal Terms (operator pays us)</label>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Deal Type</label>
          <select name="deal_type" id="deal_type" class={inputCls}>
            <option value="CPA" selected={op.deal_type === 'CPA'}>CPA</option>
            <option value="RevShare" selected={op.deal_type === 'RevShare'}>RevShare</option>
            <option value="Spend" selected={op.deal_type === 'Spend'}>% of Spend</option>
            <option value="Hybrid" selected={op.deal_type === 'Hybrid'}>Hybrid (CPA + RevShare)</option>
          </select>
        </div>
        <div id="cpa-group" class={op.deal_type === 'RevShare' || op.deal_type === 'Spend' ? 'hidden' : ''}>
          <label class="block text-xs text-gray-500 mb-1">CPA Value ($)</label>
          <input type="number" name="cpa_value" step="0.01" min="0" value={op.cpa_value || ''} placeholder="50" class={inputCls} />
        </div>
        <div id="rev-group" class={op.deal_type === 'CPA' || op.deal_type === 'Spend' ? 'hidden' : ''}>
          <label class="block text-xs text-gray-500 mb-1">RevShare %</label>
          <input type="number" name="revshare_pct" step="0.01" min="0" max="100" value={op.revshare_pct || ''} placeholder="30" class={inputCls} />
        </div>
        <div id="spend-group" class={op.deal_type !== 'Spend' ? 'hidden' : ''}>
          <label class="block text-xs text-gray-500 mb-1">% of Spend</label>
          <input type="number" name="spend_pct" step="0.01" min="0" max="100" value={op.spend_pct || ''} placeholder="15" class={inputCls} />
        </div>
      </div>
    </div>

    <!-- Rating -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Rating <span class="text-gray-600">(1–10)</span></label>
      <input type="number" name="rating" id="rating_input" min="1" max="10" value={op.rating ?? ''} placeholder="e.g. 8" class={inputCls} />
      <div class="flex gap-0.5 mt-2">
        {Array.from({ length: 10 }, (_, i) => (
          <span class={`w-2 h-2 rounded-full rating-dot transition-colors ${
            op.rating != null && i < op.rating
              ? op.rating >= 8 ? 'bg-success' : op.rating >= 5 ? 'bg-warning' : 'bg-danger'
              : 'bg-gray-700'
          }`} data-index={i + 1}></span>
        ))}
      </div>
    </div>

    <!-- Notes -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Notes</label>
      <textarea name="notes" rows="3" class={`${inputCls} resize-none`}>{op.notes || ''}</textarea>
    </div>

    <div class="flex items-center justify-between pt-2">
      <button type="submit" class="bg-accent hover:bg-accent-dark text-white font-medium px-6 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
        Save Changes
      </button>
      <button type="submit" name="_action" value="delete"
        onclick="return confirm('Delete this operator?')"
        class="bg-danger/10 text-danger hover:bg-danger/20 border border-danger/20 rounded-lg px-4 py-2.5 text-sm transition-colors">
        Delete Operator
      </button>
    </div>
  </form>
</Layout>

<script>
  const dealType = document.getElementById('deal_type') as HTMLSelectElement;
  const cpaGroup = document.getElementById('cpa-group')!;
  const revGroup = document.getElementById('rev-group')!;
  const spendGroup = document.getElementById('spend-group')!;

  function updateDealFields() {
    const v = dealType.value;
    cpaGroup.classList.toggle('hidden', v === 'RevShare' || v === 'Spend');
    revGroup.classList.toggle('hidden', v === 'CPA' || v === 'Spend');
    spendGroup.classList.toggle('hidden', v !== 'Spend');
  }
  dealType.addEventListener('change', updateDealFields);

  const input = document.getElementById('rating_input') as HTMLInputElement;
  const dots = document.querySelectorAll('.rating-dot');
  function updateDots(val: number) {
    dots.forEach((dot, i) => {
      (dot as HTMLElement).className = `w-2 h-2 rounded-full rating-dot transition-colors ${
        i < val ? (val >= 8 ? 'bg-success' : val >= 5 ? 'bg-warning' : 'bg-danger') : 'bg-gray-700'
      }`;
    });
  }
  input?.addEventListener('input', () => updateDots(Number(input.value)));
  dots.forEach((dot, i) => {
    (dot as HTMLElement).style.cursor = 'pointer';
    dot.addEventListener('click', () => { input.value = String(i + 1); updateDots(i + 1); });
  });
</script>
