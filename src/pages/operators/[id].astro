---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';
import type { Operator } from '../../lib/types';

const { id } = Astro.params;
const trafficOptions = ['PPC', 'SEO', 'Social', 'Push', 'Native', 'Email', 'Display', 'Streaming'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    await supabase.from('operators').delete().eq('id', id!);
    return Astro.redirect('/operators');
  }

  const geoRaw = (form.get('target_geos') as string) || '';
  const geo = geoRaw.split(',').map(g => g.trim().toUpperCase()).filter(Boolean);
  const traffic = trafficOptions.filter(t => form.get(`traffic_${t}`));

  const { error } = await supabase.from('operators').update({
    name: form.get('name') as string,
    brand: (form.get('brand') as string) || null,
    target_geos: geo,
    budget_min: Number(form.get('budget_min')) || 0,
    budget_max: Number(form.get('budget_max')) || 0,
    preferred_traffic: traffic,
    deal_type: (form.get('deal_type') as string) || 'CPA',
    cpa_value: Number(form.get('cpa_value')) || null,
    revshare_pct: Number(form.get('revshare_pct')) || null,
    notes: (form.get('notes') as string) || null,
  }).eq('id', id!);

  if (!error) return Astro.redirect('/operators');
}

const { data: operator } = await supabase.from('operators').select('*').eq('id', id!).single();

if (!operator) return Astro.redirect('/operators');
const op = operator as Operator;
---

<Layout title={`Edit ${op.name}`}>
  <div class="mb-8">
    <a href="/operators" class="text-gray-500 hover:text-gray-300 text-sm">&larr; Back to Operators</a>
    <h1 class="text-2xl font-bold mt-2">{op.name}</h1>
    {op.brand && <p class="text-gray-500 text-sm">{op.brand}</p>}
  </div>

  <form method="POST" class="bg-card rounded-xl border border-gray-800 p-6 max-w-2xl space-y-5">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Name *</label>
        <input type="text" name="name" required value={op.name}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Brand</label>
        <input type="text" name="brand" value={op.brand || ''}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-1">Target GEOs (comma-separated)</label>
      <input type="text" name="target_geos" value={op.target_geos.join(', ')}
        class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Min (USD)</label>
        <input type="number" name="budget_min" step="0.01" min="0" value={op.budget_min}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Max (USD)</label>
        <input type="number" name="budget_max" step="0.01" min="0" value={op.budget_max}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-2">Preferred Traffic Types</label>
      <div class="flex flex-wrap gap-3">
        {trafficOptions.map(t => (
          <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
            <input type="checkbox" name={`traffic_${t}`}
              checked={op.preferred_traffic.includes(t)}
              class="rounded bg-gray-800 border-gray-700 text-accent focus:ring-accent" />
            {t}
          </label>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Deal Type</label>
        <select name="deal_type"
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none">
          <option value="CPA" selected={op.deal_type === 'CPA'}>CPA</option>
          <option value="RevShare" selected={op.deal_type === 'RevShare'}>RevShare</option>
          <option value="Hybrid" selected={op.deal_type === 'Hybrid'}>Hybrid</option>
        </select>
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">CPA Value (USD)</label>
        <input type="number" name="cpa_value" step="0.01" min="0" value={op.cpa_value || ''}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">RevShare %</label>
        <input type="number" name="revshare_pct" step="0.01" min="0" max="100" value={op.revshare_pct || ''}
          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none" />
      </div>
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-1">Notes</label>
      <textarea name="notes" rows="3"
        class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none resize-none">{op.notes || ''}</textarea>
    </div>

    <div class="flex items-center justify-between pt-2">
      <button type="submit" class="bg-accent hover:bg-indigo-600 text-white font-medium px-6 py-2.5 rounded-lg transition-colors">
        Save Changes
      </button>
      <button type="submit" name="_action" value="delete"
        onclick="return confirm('Delete this operator?')"
        class="bg-danger/10 text-danger hover:bg-danger/20 rounded-lg px-4 py-2.5 text-sm transition-colors">
        Delete Operator
      </button>
    </div>
  </form>
</Layout>
