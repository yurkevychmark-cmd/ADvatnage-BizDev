---
import Layout from '../../components/Layout.astro';

const trafficOptions = ['Meta Ads', 'InApp', 'DSP', 'Google Ads', 'TikTok Ads'];

let dbError: string | null = null;

if (Astro.request.method === 'POST') {
  const { supabase } = await import('../../lib/supabase');
  const form = await Astro.request.formData();
  const geoRaw = (form.get('target_geos') as string) || '';
  const geo = geoRaw.split(',').map(g => g.trim().toUpperCase()).filter(Boolean);
  const traffic = trafficOptions.filter(t => form.get(`traffic_${t}`));
  const ratingRaw = form.get('rating') as string;
  const dealType = form.get('deal_type') as string;
  const linksRaw = form.getAll('links[]') as string[];
  const links = linksRaw.map(l => l.trim()).filter(Boolean);
  const { error } = await supabase.from('operators').insert({
    name: form.get('name') as string,
    brand_name: (form.get('brand') as string) || null,
    contact: (form.get('contact') as string) || null,
    payment_method: (form.get('payment_method') as string) || null,
    target_geos: geo,
    budget_min: Number(form.get('budget_min')) || 0,
    budget_max: Number(form.get('budget_max')) || 0,
    preferred_traffic: traffic,
    deal_type: dealType || 'CPA',
    cpa_value: Number(form.get('cpa_value')) || null,
    revshare_pct: Number(form.get('revshare_pct')) || null,
    spend_pct: Number(form.get('spend_pct')) || null,
    rating: ratingRaw ? Number(ratingRaw) : null,
    notes: (form.get('notes') as string) || null,
    links: links.length > 0 ? links : null,
  });
  if (!error) {
    await supabase.from('activity_log').insert({ entity_type: 'operator', entity_name: form.get('name') as string, action: 'created' });
    return Astro.redirect('/operators');
  }
  dbError = error.message;
}

const inputCls = "w-full bg-card-2 border border-border rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none placeholder-gray-600 transition-colors";
---

<Layout title="Add Operator">
  <div class="mb-8">
    <a href="/operators" class="text-gray-600 hover:text-gray-300 text-sm transition-colors">&larr; Back to Operators</a>
    <h1 class="text-2xl font-bold mt-2">Add Operator</h1>
  </div>

  {dbError && (
    <div class="mb-4 bg-danger/10 border border-danger/30 text-danger text-sm rounded-lg px-4 py-3 max-w-2xl">
      DB Error: {dbError}
    </div>
  )}

  <form method="POST" class="bg-card rounded-xl border border-border p-6 max-w-2xl space-y-5">

    <!-- Name + Brand -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Name *</label>
        <input type="text" name="name" required class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Brand</label>
        <input type="text" name="brand" class={inputCls} />
      </div>
    </div>

    <!-- Contact + Payment Method -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Contact <span class="text-gray-600">(TG / WhatsApp)</span></label>
        <input type="text" name="contact" placeholder="@username or +380…" class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Payment Method</label>
        <select name="payment_method" class={inputCls}>
          <option value="">— Select —</option>
          <option value="Bank Transfer">Bank Transfer</option>
          <option value="Crypto">Crypto</option>
          <option value="Bank Transfer + Crypto">Bank Transfer + Crypto</option>
        </select>
      </div>
    </div>

    <!-- Target GEOs -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Target GEOs <span class="text-gray-600">(comma-separated)</span></label>
      <input type="text" name="target_geos" placeholder="DE, BR, IN, US" class={inputCls} />
    </div>

    <!-- Budget -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Min (USD/mo)</label>
        <input type="number" name="budget_min" step="100" min="0" placeholder="10000" class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Budget Max (USD/mo)</label>
        <input type="number" name="budget_max" step="100" min="0" placeholder="100000" class={inputCls} />
      </div>
    </div>

    <!-- Traffic Types -->
    <div>
      <label class="block text-sm text-gray-400 mb-2">Preferred Traffic Types</label>
      <div class="flex flex-wrap gap-3">
        {trafficOptions.map(t => (
          <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer group">
            <input type="checkbox" name={`traffic_${t}`} class="rounded bg-card-2 border-border text-accent focus:ring-accent focus:ring-offset-0" />
            <span class="group-hover:text-accent transition-colors">{t}</span>
          </label>
        ))}
      </div>
    </div>

    <!-- Deal Type + Dynamic Value -->
    <div>
      <label class="block text-sm text-gray-400 mb-2">Deal Terms (operator pays us)</label>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Deal Type</label>
          <select name="deal_type" id="deal_type" class={inputCls}>
            <option value="CPA">CPA</option>
            <option value="RevShare">RevShare</option>
            <option value="Spend">% of Spend</option>
            <option value="Hybrid">Hybrid (CPA + RevShare)</option>
          </select>
        </div>
        <div id="cpa-group">
          <label class="block text-xs text-gray-500 mb-1" id="value-label">CPA Value ($)</label>
          <input type="number" name="cpa_value" id="cpa-input" step="0.01" min="0" placeholder="50" class={inputCls} />
        </div>
        <div id="rev-group" class="hidden">
          <label class="block text-xs text-gray-500 mb-1">RevShare %</label>
          <input type="number" name="revshare_pct" step="0.01" min="0" max="100" placeholder="30" class={inputCls} />
        </div>
        <div id="spend-group" class="hidden">
          <label class="block text-xs text-gray-500 mb-1">% of Spend</label>
          <input type="number" name="spend_pct" step="0.01" min="0" max="100" placeholder="15" class={inputCls} />
        </div>
      </div>
    </div>

    <!-- Rating -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Rating <span class="text-gray-600">(1–10)</span></label>
      <input type="number" name="rating" id="rating_input" min="1" max="10" placeholder="e.g. 8" class={inputCls} />
      <div class="flex gap-0.5 mt-2">
        {Array.from({ length: 10 }, (_, i) => (
          <span class="w-2 h-2 rounded-full bg-gray-700 rating-dot transition-colors" data-index={i + 1}></span>
        ))}
      </div>
    </div>

    <!-- Links -->
    <div>
      <label class="block text-sm text-gray-400 mb-2">Links <span class="text-gray-600">(сайт, афіліат-кабінет)</span></label>
      <div id="links-container" class="space-y-2">
        <div class="flex gap-2 link-row">
          <input type="url" name="links[]" placeholder="https://..." class={`${inputCls} flex-1`} />
          <button type="button" onclick="this.closest('.link-row').remove()" class="text-gray-600 hover:text-danger px-2 text-lg leading-none transition-colors">×</button>
        </div>
      </div>
      <button type="button" id="add-link" class="mt-2 text-xs text-accent hover:text-accent/80 transition-colors">+ Додати посилання</button>
    </div>

    <!-- Notes -->
    <div>
      <label class="block text-sm text-gray-400 mb-1">Notes</label>
      <textarea name="notes" rows="3" class={`${inputCls} resize-none`}></textarea>
    </div>

    <button type="submit" class="bg-accent hover:bg-accent-dark text-white font-medium px-6 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
      Create Operator
    </button>
  </form>
</Layout>

<script>
  // Dynamic deal type fields
  const dealType = document.getElementById('deal_type') as HTMLSelectElement;
  const cpaGroup = document.getElementById('cpa-group')!;
  const revGroup = document.getElementById('rev-group')!;
  const spendGroup = document.getElementById('spend-group')!;

  function updateDealFields() {
    const v = dealType.value;
    cpaGroup.classList.toggle('hidden', v === 'RevShare' || v === 'Spend');
    revGroup.classList.toggle('hidden', v === 'CPA' || v === 'Spend');
    spendGroup.classList.toggle('hidden', v !== 'Spend');
  }
  dealType.addEventListener('change', updateDealFields);
  updateDealFields();

  // Dynamic links
  document.getElementById('add-link')?.addEventListener('click', () => {
    const container = document.getElementById('links-container')!;
    const row = document.createElement('div');
    row.className = 'flex gap-2 link-row';
    row.innerHTML = `<input type="url" name="links[]" placeholder="https://..." class="flex-1 bg-card-2 border border-border rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none placeholder-gray-600 transition-colors" /><button type="button" onclick="this.closest('.link-row').remove()" class="text-gray-600 hover:text-danger px-2 text-lg leading-none transition-colors">×</button>`;
    container.appendChild(row);
  });

  // Rating dots
  const input = document.getElementById('rating_input') as HTMLInputElement;
  const dots = document.querySelectorAll('.rating-dot');
  function updateDots(val: number) {
    dots.forEach((dot, i) => {
      (dot as HTMLElement).className = `w-2 h-2 rounded-full rating-dot transition-colors ${
        i < val ? (val >= 8 ? 'bg-success' : val >= 5 ? 'bg-warning' : 'bg-danger') : 'bg-gray-700'
      }`;
    });
  }
  input?.addEventListener('input', () => updateDots(Number(input.value)));
  dots.forEach((dot, i) => {
    (dot as HTMLElement).style.cursor = 'pointer';
    dot.addEventListener('click', () => { input.value = String(i + 1); updateDots(i + 1); });
  });
</script>
