---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: deals } = await supabase
  .from('projects')
  .select('id, name, pipeline_stage, planned_spend, actual_spend, geos, buyer:buyers(name), operator:operators(name)')
  .order('created_at', { ascending: false });

const dealsArr = (deals ?? []) as any[];

const stageBadge: Record<string, string> = {
  new:         'bg-gray-700/60 text-gray-300 border-gray-600',
  negotiation: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/25',
  trial:       'bg-purple-500/15 text-purple-400 border-purple-500/25',
  active:      'bg-green-500/15 text-green-400 border-green-500/25',
  completed:   'bg-blue-500/15 text-blue-400 border-blue-500/25',
  no_deal:     'bg-red-500/15 text-red-400 border-red-500/25',
};
const stageLabel: Record<string, string> = {
  new: 'Новий', negotiation: 'Переговори', trial: 'Тестовий',
  active: 'Ретеншин', completed: 'Завершено', no_deal: 'Не домовились',
};

function fmtUSD(n: number) {
  if (!n) return '—';
  if (n >= 1_000_000) return '$' + (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return '$' + (n / 1_000).toFixed(1) + 'K';
  return '$' + Math.round(n).toLocaleString();
}
---

<Layout title="Reports">
  <div class="mb-8 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold">📊 Reports</h1>
      <p class="text-gray-500 text-sm mt-1">Оберіть проект для перегляду щоденних звітів</p>
    </div>
    <div class="flex items-center gap-2">
      <input
        type="text"
        id="report-search"
        placeholder="Пошук проекту…"
        class="bg-card border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none w-56"
      />
    </div>
  </div>

  {dealsArr.length === 0 ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500 mb-2">Немає угод для звітів.</p>
      <a href="/deals" class="text-accent text-sm hover:underline">Перейти до угод →</a>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" id="reports-grid">
      {dealsArr.map((deal: any) => {
        const stage = deal.pipeline_stage ?? 'new';
        const badge = stageBadge[stage] ?? stageBadge.new;
        const label = stageLabel[stage] ?? stage;
        const geos = (deal.geos ?? []) as string[];
        const buyerName = deal.buyer?.name ?? '—';
        const opName = deal.operator?.name ?? '—';

        return (
          <a
            href={`/reports/${deal.id}`}
            data-search={`${buyerName} ${opName} ${geos.join(' ')}`.toLowerCase()}
            class="report-card group bg-card hover:bg-card-2 border border-border hover:border-accent/30 rounded-xl p-5 transition-all flex flex-col gap-3"
          >
            <!-- Header -->
            <div class="flex items-start justify-between gap-2">
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-100 truncate group-hover:text-white transition-colors">
                  {buyerName}
                </p>
                <p class="text-sm text-gray-500 truncate mt-0.5">
                  <span class="text-gray-600">↔</span> {opName}
                </p>
              </div>
              <span class={`text-xs px-2 py-0.5 rounded border font-medium shrink-0 ${badge}`}>
                {label}
              </span>
            </div>

            <!-- Spend row -->
            <div class="flex items-center gap-4 text-sm">
              <div>
                <p class="text-xs text-gray-600 mb-0.5">Planned</p>
                <p class="font-mono text-gray-300">{fmtUSD(Number(deal.planned_spend) || 0)}</p>
              </div>
              {deal.actual_spend != null && (
                <div>
                  <p class="text-xs text-gray-600 mb-0.5">Actual</p>
                  <p class="font-mono text-success font-semibold">{fmtUSD(Number(deal.actual_spend) || 0)}</p>
                </div>
              )}
            </div>

            <!-- GEOs -->
            {geos.length > 0 && (
              <div class="flex flex-wrap gap-1">
                {geos.slice(0, 6).map((g: string) => (
                  <span class="text-xs font-mono bg-card-2 border border-border px-1.5 py-0.5 rounded text-gray-400">{g}</span>
                ))}
                {geos.length > 6 && (
                  <span class="text-xs text-gray-600">+{geos.length - 6}</span>
                )}
              </div>
            )}

            <!-- Arrow -->
            <div class="text-xs text-gray-700 group-hover:text-accent transition-colors mt-auto">
              Відкрити звіт →
            </div>
          </a>
        );
      })}
    </div>
  )}
</Layout>

<script>
  const searchInput = document.getElementById('report-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.report-card') as NodeListOf<HTMLElement>;

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    cards.forEach(card => {
      const text = card.dataset.search ?? '';
      card.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
  });
</script>
