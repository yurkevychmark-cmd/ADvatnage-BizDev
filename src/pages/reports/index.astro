---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: deals } = await supabase
  .from('projects')
  .select('id, name, pipeline_stage, planned_spend, actual_spend, geos, buyer:buyers(name), operator:operators(name)')
  .order('created_at', { ascending: false });

const dealsArr = (deals ?? []) as any[];

const stageBadge: Record<string, string> = {
  new:         'bg-gray-700/60 text-gray-300 border-gray-600',
  negotiation: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/25',
  trial:       'bg-purple-500/15 text-purple-400 border-purple-500/25',
  active:      'bg-green-500/15 text-green-400 border-green-500/25',
  completed:   'bg-blue-500/15 text-blue-400 border-blue-500/25',
  no_deal:     'bg-red-500/15 text-red-400 border-red-500/25',
};
const stageLabel: Record<string, string> = {
  new: 'New', negotiation: 'Negotiation', trial: 'Trial',
  active: 'Retention', completed: 'Completed', no_deal: 'No Deal',
};

function fmtUSD(n: number) {
  if (!n) return '—';
  if (n >= 1_000_000) return '$' + (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return '$' + (n / 1_000).toFixed(1) + 'K';
  return '$' + Math.round(n).toLocaleString();
}
---

<Layout title="Reports">
  <!-- Header -->
  <div class="mb-6 flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold">📊 Reports</h1>
      <p class="text-gray-500 text-sm mt-1">Select a project to view daily reports</p>
    </div>
    <input
      type="text"
      id="report-search"
      placeholder="Search…"
      class="bg-card border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none w-52"
    />
  </div>

  <!-- Stage filter tabs -->
  <div class="flex flex-wrap gap-1.5 mb-5" id="stage-filters">
    <button data-stage="all" class="stage-btn active-stage-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-colors bg-card text-white border-accent/40 shadow">
      All <span class="text-xs ml-1 text-gray-400">{dealsArr.length}</span>
    </button>
    {(['negotiation','trial','active','completed','new','no_deal'] as const).map(s => {
      const count = dealsArr.filter(d => d.pipeline_stage === s).length;
      if (count === 0) return null;
      return (
        <button data-stage={s} class={`stage-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-colors ${stageBadge[s]}`}>
          {stageLabel[s]} <span class="text-xs ml-1 opacity-70">{count}</span>
        </button>
      );
    })}
  </div>

  <!-- List -->
  {dealsArr.length === 0 ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500 mb-2">No deals yet.</p>
      <a href="/deals" class="text-accent text-sm hover:underline">Go to Deals →</a>
    </div>
  ) : (
    <div class="space-y-2" id="reports-list">
      {dealsArr.map((deal: any) => {
        const stage = deal.pipeline_stage ?? 'new';
        const badge = stageBadge[stage] ?? stageBadge.new;
        const label = stageLabel[stage] ?? stage;
        const geos = (deal.geos ?? []) as string[];
        const buyerName = deal.buyer?.name ?? '—';
        const opName = deal.operator?.name ?? '—';

        return (
          <a
            href={`/reports/${deal.id}`}
            data-search={`${buyerName} ${opName} ${geos.join(' ')}`.toLowerCase()}
            data-stage={stage}
            class="report-row group flex items-center gap-4 bg-card hover:bg-card-2 border border-border hover:border-accent/20 rounded-xl px-5 py-3.5 transition-all"
          >
            <!-- Icon -->
            <span class="text-xl shrink-0">📄</span>

            <!-- Names -->
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-gray-100 group-hover:text-white transition-colors truncate">
                {buyerName} <span class="text-gray-600 font-normal mx-1">↔</span> {opName}
              </p>
              {geos.length > 0 && (
                <div class="flex gap-1 mt-1 flex-wrap">
                  {geos.slice(0, 5).map((g: string) => (
                    <span class="text-[10px] font-mono bg-card-2 border border-border px-1 py-0.5 rounded text-gray-500">{g}</span>
                  ))}
                  {geos.length > 5 && <span class="text-[10px] text-gray-700">+{geos.length - 5}</span>}
                </div>
              )}
            </div>

            <!-- Stage badge -->
            <span class={`text-xs px-2.5 py-1 rounded-lg border font-medium shrink-0 ${badge}`}>
              {label}
            </span>

            <!-- Spend -->
            <div class="text-right shrink-0 hidden sm:block">
              {deal.actual_spend != null ? (
                <p class="text-sm font-mono font-semibold text-success">{fmtUSD(Number(deal.actual_spend))}</p>
              ) : (
                <p class="text-sm font-mono text-gray-500">{fmtUSD(Number(deal.planned_spend) || 0)}</p>
              )}
              <p class="text-[10px] text-gray-700">{deal.actual_spend != null ? 'actual' : 'planned'}</p>
            </div>

            <!-- Arrow -->
            <svg class="text-gray-700 group-hover:text-accent transition-colors shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        );
      })}
    </div>
  )}

  <p id="no-results" class="hidden text-center text-gray-600 text-sm py-12">Nothing found</p>
</Layout>

<script>
  const searchInput = document.getElementById('report-search') as HTMLInputElement | null;
  const rows = document.querySelectorAll('.report-row') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results');
  const stageButtons = document.querySelectorAll('.stage-btn') as NodeListOf<HTMLButtonElement>;

  let currentStage = 'all';
  let currentQuery = '';

  function filterRows() {
    let visible = 0;
    rows.forEach(row => {
      const matchStage = currentStage === 'all' || row.dataset.stage === currentStage;
      const matchQuery = !currentQuery || (row.dataset.search ?? '').includes(currentQuery);
      const show = matchStage && matchQuery;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', () => {
    currentQuery = searchInput.value.toLowerCase().trim();
    filterRows();
  });

  stageButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      currentStage = btn.dataset.stage ?? 'all';
      stageButtons.forEach(b => {
        b.classList.remove('active-stage-btn', 'bg-card', 'text-white', 'border-accent/40', 'shadow');
      });
      btn.classList.add('active-stage-btn', 'bg-card', 'text-white', 'border-accent/40', 'shadow');
      filterRows();
    });
  });
</script>
