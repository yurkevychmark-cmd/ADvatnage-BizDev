---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

// ── POST actions ──────────────────────────────────────────────────────────
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;

  async function resolveEntityName(entityType: string | null, entityId: string | null): Promise<string | null> {
    if (!entityId || !entityType) return null;
    const table = entityType === 'buyer' ? 'buyers' : entityType === 'operator' ? 'operators' : 'projects';
    const { data } = await supabase.from(table).select('name').eq('id', entityId).single();
    return (data as any)?.name ?? null;
  }

  if (action === 'create') {
    const entityType = (form.get('entity_type') as string) || null;
    const entityId   = (form.get('entity_id')   as string) || null;
    const entityName = await resolveEntityName(entityType, entityId);
    const { error } = await supabase.from('tasks').insert({
      title:       ((form.get('title') as string) ?? '').trim(),
      entity_type: entityType,
      entity_id:   entityId || null,
      entity_name: entityName,
      assigned_to: (form.get('assigned_to') as string) || null,
      start_date:  (form.get('start_date')  as string) || null,
      due_date:    (form.get('due_date')    as string) || null,
      priority:    (form.get('priority')    as string) || 'medium',
      status:      'open',
    });
    if (error) return Astro.redirect(`/tasks?err=${encodeURIComponent(error.message)}`);
  }

  if (action === 'update') {
    const entityType = (form.get('entity_type') as string) || null;
    const entityId   = (form.get('entity_id')   as string) || null;
    const entityName = await resolveEntityName(entityType, entityId);
    await supabase.from('tasks').update({
      title:       ((form.get('title') as string) ?? '').trim(),
      entity_type: entityType,
      entity_id:   entityId || null,
      entity_name: entityName,
      assigned_to: (form.get('assigned_to') as string) || null,
      start_date:  (form.get('start_date')  as string) || null,
      due_date:    (form.get('due_date')    as string) || null,
      priority:    (form.get('priority')    as string) || 'medium',
    }).eq('id', form.get('task_id') as string);
  }

  if (action === 'set_status') {
    await supabase.from('tasks')
      .update({ status: form.get('status') })
      .eq('id', form.get('task_id') as string);
  }

  if (action === 'delete') {
    await supabase.from('tasks').delete().eq('id', form.get('task_id') as string);
  }

  return Astro.redirect('/tasks');
}

// ── Data ──────────────────────────────────────────────────────────────────
const dbError = Astro.url.searchParams.get('err');

const { data: allTasks } = await supabase
  .from('tasks')
  .select('*')
  .order('created_at', { ascending: false });

const { data: buyers }    = await supabase.from('buyers').select('id, name').order('name');
const { data: operators } = await supabase.from('operators').select('id, name').order('name');
const { data: deals }     = await supabase.from('projects').select('id, name').order('name');

const tasksJson     = JSON.stringify(allTasks    ?? []);
const buyersJson    = JSON.stringify(buyers      ?? []);
const operatorsJson = JSON.stringify(operators   ?? []);
const dealsJson     = JSON.stringify(deals       ?? []);

const totalOpen = (allTasks ?? []).filter((t: any) => t.status === 'open').length;
const totalWip  = (allTasks ?? []).filter((t: any) => t.status === 'in_progress').length;
const totalDone = (allTasks ?? []).filter((t: any) => t.status === 'done').length;
---

<Layout title="Tasks">

<!-- ── Edit slide-over ──────────────────────────────────────────────────── -->
<div id="edit-overlay" class="fixed inset-0 bg-black/50 z-40 hidden" onclick="closeEditPanel()"></div>
<div id="edit-panel" class="fixed right-0 top-0 h-full w-full max-w-md bg-card border-l border-border z-50 flex flex-col translate-x-full transition-transform duration-300 shadow-2xl">
  <div class="flex items-center justify-between px-6 py-4 border-b border-border bg-card-2">
    <h3 class="font-semibold text-base" id="edit-panel-title">Edit Task</h3>
    <button onclick="closeEditPanel()" class="text-gray-600 hover:text-gray-300 transition-colors text-xl leading-none">✕</button>
  </div>
  <div class="flex-1 overflow-y-auto px-6 py-5">
    <form method="POST" id="edit-task-form" class="space-y-4">
      <input type="hidden" name="_action" value="update" />
      <input type="hidden" name="task_id" id="edit-task-id" />

      <div>
        <label class="block text-xs text-gray-500 mb-1">Title <span class="text-danger">*</span></label>
        <input type="text" name="title" id="edit-title" required
          class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Linked to</label>
          <select name="entity_type" id="edit-entity-type"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-300 focus:border-accent outline-none">
            <option value="">— General —</option>
            <option value="operator">Operator</option>
            <option value="buyer">Buyer</option>
            <option value="deal">Deal</option>
          </select>
        </div>
        <div id="edit-entity-wrapper">
          <label class="block text-xs text-gray-500 mb-1">Entity</label>
          <div class="relative">
            <input type="text" id="edit-entity-search" placeholder="Search…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="entity_id" id="edit-entity-id" />
            <div id="edit-entity-dd" class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-xl max-h-48 overflow-y-auto"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Priority</label>
          <select name="priority" id="edit-priority"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-300 focus:border-accent outline-none">
            <option value="high">🔴 High</option>
            <option value="medium">🟡 Medium</option>
            <option value="low">⚪ Low</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Assigned to</label>
          <input type="text" name="assigned_to" id="edit-assigned"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Дата старту</label>
          <input type="date" name="start_date" id="edit-start-date"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Дата завершення</label>
          <input type="date" name="due_date" id="edit-due-date"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 bg-accent hover:bg-accent-dark text-white text-sm font-medium py-2 rounded-lg transition-colors">
          Save Changes
        </button>
      </div>
    </form>

    <!-- Delete zone -->
    <div class="mt-6 pt-4 border-t border-border/40">
      <form method="POST" id="edit-delete-form">
        <input type="hidden" name="_action" value="delete" />
        <input type="hidden" name="task_id" id="edit-delete-id" />
        <button type="submit" onclick="return confirm('Видалити цей таск?')"
          class="w-full text-danger hover:bg-danger/10 border border-danger/20 text-sm py-2 rounded-lg transition-colors">
          🗑 Delete Task
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ── Create slide-over ─────────────────────────────────────────────────── -->
<div id="create-overlay" class="fixed inset-0 bg-black/50 z-40 hidden" onclick="closeCreatePanel()"></div>
<div id="create-panel" class="fixed right-0 top-0 h-full w-full max-w-md bg-card border-l border-border z-50 flex flex-col translate-x-full transition-transform duration-300 shadow-2xl">
  <div class="flex items-center justify-between px-6 py-4 border-b border-border bg-card-2">
    <h3 class="font-semibold text-base">New Task</h3>
    <button onclick="closeCreatePanel()" class="text-gray-600 hover:text-gray-300 transition-colors text-xl leading-none">✕</button>
  </div>
  <div class="flex-1 overflow-y-auto px-6 py-5">
    <form method="POST" class="space-y-4">
      <input type="hidden" name="_action" value="create" />
      <input type="hidden" name="status" id="create-status-hidden" value="open" />

      <div>
        <label class="block text-xs text-gray-500 mb-1">Title <span class="text-danger">*</span></label>
        <input type="text" name="title" id="create-title" required placeholder="Опишіть завдання…"
          class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Linked to</label>
          <select name="entity_type" id="create-entity-type"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-300 focus:border-accent outline-none">
            <option value="">— General —</option>
            <option value="operator">Operator</option>
            <option value="buyer">Buyer</option>
            <option value="deal">Deal</option>
          </select>
        </div>
        <div id="create-entity-wrapper" class="hidden">
          <label class="block text-xs text-gray-500 mb-1">Entity</label>
          <div class="relative">
            <input type="text" id="create-entity-search" placeholder="Search…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="entity_id" id="create-entity-id" />
            <div id="create-entity-dd" class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-xl max-h-48 overflow-y-auto"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Priority</label>
          <select name="priority"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-300 focus:border-accent outline-none">
            <option value="medium">🟡 Medium</option>
            <option value="high">🔴 High</option>
            <option value="low">⚪ Low</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Assigned to</label>
          <input type="text" name="assigned_to" placeholder="Ім'я…"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Дата старту</label>
          <input type="date" name="start_date"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Дата завершення</label>
          <input type="date" name="due_date"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <button type="submit" class="w-full bg-accent hover:bg-accent-dark text-white text-sm font-medium py-2.5 rounded-lg transition-colors mt-2">
        Create Task
      </button>
    </form>
  </div>
</div>

<!-- ── Page header ───────────────────────────────────────────────────────── -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">Tasks</h1>
    <p class="text-gray-500 text-sm mt-1">Відкриті завдання та очікування</p>
  </div>
  <button onclick="openCreatePanel('open')" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
    + New Task
  </button>
</div>

{dbError && (
  <div class="mb-4 bg-danger/10 border border-danger/30 text-danger text-sm rounded-lg px-4 py-3">
    <strong>DB Error:</strong> {dbError}
    <p class="text-xs mt-1 text-danger/70">Запустіть SQL-міграцію для додавання колонок start_date/due_date.</p>
  </div>
)}

<!-- ── Kanban board ──────────────────────────────────────────────────────── -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="kanban-board">

  <!-- Open -->
  <div class="kanban-col flex flex-col bg-card rounded-xl border border-border overflow-hidden" data-status="open">
    <div class="px-4 py-3 border-b border-border bg-card-2/60 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400 inline-block"></span>
        <span class="text-sm font-semibold text-gray-200">Відкриті</span>
        <span class="text-xs bg-card border border-border text-gray-500 rounded-full px-2 py-0.5 font-mono col-count">{totalOpen}</span>
      </div>
      <button onclick="openCreatePanel('open')" class="text-gray-600 hover:text-accent transition-colors text-xl leading-none font-light" title="Add task">+</button>
    </div>
    <div class="cards-zone flex-1 overflow-y-auto p-3 space-y-2 min-h-[120px]" data-status="open"></div>
  </div>

  <!-- In Progress -->
  <div class="kanban-col flex flex-col bg-card rounded-xl border border-border overflow-hidden" data-status="in_progress">
    <div class="px-4 py-3 border-b border-border bg-card-2/60 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-warning inline-block"></span>
        <span class="text-sm font-semibold text-gray-200">В процесі</span>
        <span class="text-xs bg-card border border-border text-gray-500 rounded-full px-2 py-0.5 font-mono col-count">{totalWip}</span>
      </div>
      <button onclick="openCreatePanel('in_progress')" class="text-gray-600 hover:text-accent transition-colors text-xl leading-none font-light" title="Add task">+</button>
    </div>
    <div class="cards-zone flex-1 overflow-y-auto p-3 space-y-2 min-h-[120px]" data-status="in_progress"></div>
  </div>

  <!-- Done -->
  <div class="kanban-col flex flex-col bg-card rounded-xl border border-border overflow-hidden" data-status="done">
    <div class="px-4 py-3 border-b border-border bg-card-2/60 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-success inline-block"></span>
        <span class="text-sm font-semibold text-gray-200">Виконані</span>
        <span class="text-xs bg-card border border-border text-gray-500 rounded-full px-2 py-0.5 font-mono col-count">{totalDone}</span>
      </div>
    </div>
    <div class="cards-zone flex-1 overflow-y-auto p-3 space-y-2 min-h-[120px]" data-status="done"></div>
  </div>
</div>

</Layout>

<script define:vars={{ tasksJson, buyersJson, operatorsJson, dealsJson }}>
  let tasks      = JSON.parse(tasksJson);
  const buyersData    = JSON.parse(buyersJson);
  const operatorsData = JSON.parse(operatorsJson);
  const dealsData     = JSON.parse(dealsJson);

  // ── Helpers ────────────────────────────────────────────────────────────
  const priorityBorder = { high: 'border-l-red-500', medium: 'border-l-yellow-500', low: 'border-l-gray-600' };
  const priorityDot    = { high: '🔴', medium: '🟡', low: '⚪' };

  function formatDate(d) {
    if (!d) return null;
    const dt = new Date(d);
    return dt.toLocaleDateString('uk-UA', { day: '2-digit', month: '2-digit' });
  }
  function isOverdue(due, status) {
    if (!due || status === 'done') return false;
    return new Date(due) < new Date(new Date().toDateString());
  }

  // ── Render a single card ───────────────────────────────────────────────
  function makeCard(task) {
    const div = document.createElement('div');
    const border = priorityBorder[task.priority] || 'border-l-gray-600';
    const overdue = isOverdue(task.due_date, task.status);

    div.className = `task-card group relative bg-card-2 border border-border border-l-4 ${border} rounded-lg p-3.5 cursor-pointer hover:border-accent/40 transition-all select-none`;
    div.draggable = true;
    div.dataset.id = task.id;
    div.dataset.status = task.status;

    // Quick done checkbox (top-right)
    const nextStatus = task.status === 'done' ? 'open' : task.status === 'in_progress' ? 'done' : 'in_progress';
    const checkIcon  = task.status === 'done' ? '✓' : task.status === 'in_progress' ? '●' : '';
    const checkClass = task.status === 'done'
      ? 'bg-success border-success text-white'
      : task.status === 'in_progress'
        ? 'border-warning bg-warning/20 text-warning'
        : 'border-gray-600 hover:border-accent text-transparent';

    div.innerHTML = `
      <div class="flex items-start gap-2">
        <button class="status-btn shrink-0 w-4 h-4 rounded-full border-2 flex items-center justify-center mt-0.5 transition-all text-[9px] leading-none ${checkClass}"
          data-id="${task.id}" data-next="${nextStatus}" title="Change status">
          ${checkIcon}
        </button>
        <p class="flex-1 text-sm font-medium leading-snug ${task.status === 'done' ? 'line-through text-gray-600' : 'text-gray-100'}">${escHtml(task.title)}</p>
      </div>
      ${task.entity_name ? `
        <div class="mt-2 ml-6">
          <span class="text-[11px] text-gray-600 capitalize">${escHtml(task.entity_type ?? '')}</span>
          <span class="text-[11px] text-gray-500 ml-1">${escHtml(task.entity_name)}</span>
        </div>
      ` : ''}
      <div class="flex flex-wrap items-center gap-2 mt-2.5 ml-6">
        ${task.assigned_to ? `<span class="text-[11px] bg-card border border-border text-gray-500 px-1.5 py-0.5 rounded-full">→ ${escHtml(task.assigned_to)}</span>` : ''}
        ${task.start_date  ? `<span class="text-[11px] text-gray-700">від ${formatDate(task.start_date)}</span>` : ''}
        ${task.due_date    ? `<span class="text-[11px] font-mono ${overdue ? 'text-danger font-semibold' : 'text-gray-600'}">${overdue ? '⚠ ' : ''}до ${formatDate(task.due_date)}</span>` : ''}
      </div>
      <button class="edit-btn absolute top-2 right-2 opacity-0 group-hover:opacity-100 text-gray-600 hover:text-accent transition-all text-xs px-1.5 py-0.5 rounded bg-card border border-border"
        data-id="${task.id}" title="Edit">✎</button>
    `;

    // Status toggle
    div.querySelector('.status-btn').addEventListener('click', e => {
      e.stopPropagation();
      updateStatus(task.id, e.currentTarget.dataset.next);
    });
    // Edit button
    div.querySelector('.edit-btn').addEventListener('click', e => {
      e.stopPropagation();
      openEditPanel(task.id);
    });
    // Click anywhere on card → edit
    div.addEventListener('click', () => openEditPanel(task.id));

    return div;
  }

  function escHtml(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Render board ───────────────────────────────────────────────────────
  function renderBoard() {
    ['open', 'in_progress', 'done'].forEach(status => {
      const zone = document.querySelector(`.cards-zone[data-status="${status}"]`);
      if (!zone) return;
      zone.innerHTML = '';
      const filtered = tasks.filter(t => t.status === status);
      filtered.forEach(task => zone.appendChild(makeCard(task)));
      // Update count badge
      const col = zone.closest('.kanban-col');
      const badge = col?.querySelector('.col-count');
      if (badge) badge.textContent = filtered.length;
    });
  }

  renderBoard();

  // ── Status update via fetch ────────────────────────────────────────────
  async function updateStatus(taskId, newStatus) {
    const fd = new FormData();
    fd.append('_action', 'set_status');
    fd.append('task_id', taskId);
    fd.append('status', newStatus);
    await fetch('/tasks', { method: 'POST', body: fd });
    // Update local state
    const t = tasks.find(t => t.id === taskId);
    if (t) t.status = newStatus;
    renderBoard();
    setupDnd();
  }

  // ── Drag and drop between columns ─────────────────────────────────────
  let dragTaskId = null;

  function setupDnd() {
    document.querySelectorAll('.task-card').forEach(card => {
      card.addEventListener('dragstart', e => {
        dragTaskId = card.dataset.id;
        card.style.opacity = '0.4';
        e.dataTransfer.effectAllowed = 'move';
      });
      card.addEventListener('dragend', () => {
        card.style.opacity = '';
        document.querySelectorAll('.cards-zone').forEach(z => z.classList.remove('bg-accent/5', 'border-accent/30'));
        dragTaskId = null;
      });
    });

    document.querySelectorAll('.cards-zone').forEach(zone => {
      zone.addEventListener('dragover', e => {
        e.preventDefault();
        document.querySelectorAll('.cards-zone').forEach(z => z.classList.remove('bg-accent/5'));
        zone.classList.add('bg-accent/5');
      });
      zone.addEventListener('dragleave', () => zone.classList.remove('bg-accent/5'));
      zone.addEventListener('drop', e => {
        e.preventDefault();
        zone.classList.remove('bg-accent/5');
        const newStatus = zone.dataset.status;
        if (dragTaskId && newStatus) {
          const task = tasks.find(t => t.id === dragTaskId);
          if (task && task.status !== newStatus) {
            updateStatus(dragTaskId, newStatus);
          }
        }
      });
    });
  }
  setupDnd();

  // ── Edit panel ─────────────────────────────────────────────────────────
  function openEditPanel(taskId) {
    const task = tasks.find(t => t.id === taskId);
    if (!task) return;

    document.getElementById('edit-task-id').value    = task.id;
    document.getElementById('edit-delete-id').value  = task.id;
    document.getElementById('edit-title').value      = task.title ?? '';
    document.getElementById('edit-assigned').value   = task.assigned_to ?? '';
    document.getElementById('edit-start-date').value = task.start_date ?? '';
    document.getElementById('edit-due-date').value   = task.due_date ?? '';
    document.getElementById('edit-priority').value   = task.priority ?? 'medium';
    document.getElementById('edit-panel-title').textContent = task.title.length > 30 ? task.title.slice(0, 30) + '…' : task.title;

    // Entity
    const entityTypeEl = document.getElementById('edit-entity-type');
    entityTypeEl.value = task.entity_type ?? '';
    document.getElementById('edit-entity-id').value = task.entity_id ?? '';
    const searchEl = document.getElementById('edit-entity-search');
    searchEl.value = task.entity_name ?? '';
    setupEntitySearch('edit', task.entity_type);

    document.getElementById('edit-overlay').classList.remove('hidden');
    document.getElementById('edit-panel').classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  window.closeEditPanel = function() {
    document.getElementById('edit-overlay').classList.add('hidden');
    document.getElementById('edit-panel').classList.add('translate-x-full');
    document.body.style.overflow = '';
  };

  document.getElementById('edit-entity-type')?.addEventListener('change', e => {
    document.getElementById('edit-entity-id').value = '';
    document.getElementById('edit-entity-search').value = '';
    setupEntitySearch('edit', e.target.value);
  });

  // ── Create panel ───────────────────────────────────────────────────────
  window.openCreatePanel = function(defaultStatus = 'open') {
    document.getElementById('create-status-hidden').value = defaultStatus;
    document.getElementById('create-title').value = '';
    document.getElementById('create-entity-type').value = '';
    document.getElementById('create-entity-id').value = '';
    document.getElementById('create-entity-search') && (document.getElementById('create-entity-search').value = '');
    document.getElementById('create-entity-wrapper').classList.add('hidden');

    document.getElementById('create-overlay').classList.remove('hidden');
    document.getElementById('create-panel').classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('create-title')?.focus(), 300);
  };

  window.closeCreatePanel = function() {
    document.getElementById('create-overlay').classList.add('hidden');
    document.getElementById('create-panel').classList.add('translate-x-full');
    document.body.style.overflow = '';
  };

  document.getElementById('create-entity-type')?.addEventListener('change', e => {
    const type = e.target.value;
    document.getElementById('create-entity-id').value = '';
    if (document.getElementById('create-entity-search')) document.getElementById('create-entity-search').value = '';
    document.getElementById('create-entity-wrapper').classList.toggle('hidden', !type);
    setupEntitySearch('create', type);
  });

  // ── Searchable entity dropdown (shared) ───────────────────────────────
  function setupEntitySearch(prefix, entityType) {
    const data = entityType === 'buyer' ? buyersData : entityType === 'operator' ? operatorsData : entityType === 'deal' ? dealsData : [];
    const searchEl = document.getElementById(`${prefix}-entity-search`);
    const ddEl     = document.getElementById(`${prefix}-entity-dd`);
    const hiddenEl = document.getElementById(`${prefix}-entity-id`);
    if (!searchEl || !ddEl) return;

    function render(q) {
      const filtered = q ? data.filter(d => d.name.toLowerCase().includes(q.toLowerCase())) : data;
      ddEl.innerHTML = filtered.length
        ? filtered.map(d => `<div class="px-3 py-2 text-sm text-gray-200 hover:bg-accent/10 cursor-pointer border-b border-border/40 last:border-0" data-id="${d.id}" data-name="${encodeURIComponent(d.name)}">${d.name}</div>`).join('')
        : '<div class="px-3 py-2.5 text-xs text-gray-600 italic">No results</div>';
    }

    // Remove old listeners by cloning
    const newSearch = searchEl.cloneNode(true);
    searchEl.parentNode.replaceChild(newSearch, searchEl);
    const newDd = ddEl.cloneNode(false);
    ddEl.parentNode.replaceChild(newDd, ddEl);

    newSearch.addEventListener('focus', () => { render(newSearch.value); newDd.classList.remove('hidden'); });
    newSearch.addEventListener('input', () => { hiddenEl.value = ''; render(newSearch.value); newDd.classList.remove('hidden'); });
    newDd.addEventListener('mousedown', e => {
      const item = e.target.closest('[data-id]');
      if (!item) return;
      e.preventDefault();
      hiddenEl.value = item.dataset.id;
      newSearch.value = decodeURIComponent(item.dataset.name);
      newDd.classList.add('hidden');
    });
    document.addEventListener('click', e => {
      if (!newSearch.parentElement?.contains(e.target)) newDd.classList.add('hidden');
    });
    render('');
  }
</script>
