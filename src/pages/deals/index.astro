---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;

  if (action === 'create') {
    const buyerId = form.get('buyer_id') as string;
    const opId = form.get('operator_id') as string;
    const { data: buyer } = await supabase.from('buyers').select('name').eq('id', buyerId).single();
    const { data: op } = await supabase.from('operators').select('name').eq('id', opId).single();
    const dealType = form.get('deal_type') as string;
    const dealName = `${(buyer as any)?.name ?? '?'} ↔ ${(op as any)?.name ?? '?'}`;
    const { error: insertError } = await supabase.from('projects').insert({
      name: dealName,
      buyer_id: buyerId || null,
      operator_id: opId || null,
      pipeline_stage: form.get('pipeline_stage') || 'new',
      deal_type: dealType,
      planned_spend: Number(form.get('planned_spend')) || 0,
      expected_conversions: Number(form.get('expected_conversions')) || 0,
      cpa_payout: dealType === 'CPA' ? Number(form.get('op_value')) || 0 : 0,
      revshare_pct: dealType !== 'CPA' ? Number(form.get('op_value')) || 0 : 0,
      avg_revenue_per_user: Number(form.get('avg_revenue_per_user')) || 0,
      buyer_fee: Number(form.get('buyer_fee')) || 0,
      side_costs: Number(form.get('side_costs')) || 0,
      accounts_fee_pct: Number(form.get('accounts_fee_pct')) || 0,
      geos: (form.getAll('geos') as string[]).filter(g => g.trim().length > 0).map(g => g.trim().toUpperCase()),
      notes: (form.get('notes') as string) || null,
      status: 'active',
    });
    if (insertError) {
      return Astro.redirect(`/deals?error=${encodeURIComponent(insertError.message)}`);
    }
    await supabase.from('activity_log').insert({ entity_type: 'deal', entity_name: dealName, action: 'created' });
  }

  if (action === 'update_stage') {
    const dealId   = form.get('deal_id') as string;
    const newStage = form.get('stage') as string;
    const { data: dealRow } = await supabase.from('projects').select('name, pipeline_stage').eq('id', dealId).single();
    await supabase.from('projects').update({ pipeline_stage: newStage }).eq('id', dealId);
    if (dealRow) {
      const stageLabels: Record<string, string> = {
        new: 'Новий', negotiation: 'Переговори', trial: 'Тестовий',
        active: 'Ретеншин', completed: 'Завершено', no_deal: 'Не домовились',
      };
      const from = stageLabels[(dealRow as any).pipeline_stage] ?? (dealRow as any).pipeline_stage;
      const to   = stageLabels[newStage] ?? newStage;
      await supabase.from('activity_log').insert({
        entity_type: 'deal',
        entity_name: (dealRow as any).name,
        action: `${from} → ${to}`,
      });
    }
  }

  if (action === 'update_actuals') {
    await supabase.from('projects')
      .update({
        actual_spend: Number(form.get('actual_spend')) || null,
        actual_conversions: Number(form.get('actual_conversions')) || null,
        actual_revenue: Number(form.get('actual_revenue')) || null,
        buyer_fee: Number(form.get('buyer_fee')) || 0,
        side_costs: Number(form.get('side_costs')) || 0,
        accounts_fee_pct: Number(form.get('accounts_fee_pct')) || 0,
        geos: (form.getAll('geos') as string[]).filter(g => g.trim().length > 0).map(g => g.trim().toUpperCase()),
        notes: (form.get('notes') as string) || null,
      })
      .eq('id', form.get('deal_id') as string);
  }

  if (action === 'delete') {
    await supabase.from('projects').delete().eq('id', form.get('deal_id') as string);
  }

  return Astro.redirect('/deals');
}

const stageFilter = Astro.url.searchParams.get('stage') ?? 'all';
const createError = Astro.url.searchParams.get('error');

const query = supabase
  .from('projects')
  .select('*, buyer:buyers(id,name), operator:operators(id,name,deal_type,cpa_value,revshare_pct,spend_pct)')
  .order('sort_order', { ascending: true, nullsFirst: false })
  .order('created_at', { ascending: false });

if (stageFilter !== 'all') query.eq('pipeline_stage', stageFilter);
const { data: deals } = await query;

const { data: buyers } = await supabase.from('buyers').select('id, name, compensation_model, cooperation_model_value').order('name');
const { data: operators } = await supabase.from('operators').select('id, name, deal_type, cpa_value, revshare_pct, spend_pct').order('name');

// Serialise for client-side searchable dropdowns
const buyersJson = JSON.stringify(buyers ?? []);
const operatorsJson = JSON.stringify(operators ?? []);

const stages = [
  { key: 'all',         label: 'Всі' },
  { key: 'new',         label: 'Новий' },
  { key: 'negotiation', label: 'Переговори' },
  { key: 'trial',       label: 'Тестовий' },
  { key: 'active',      label: 'Ретеншин' },
  { key: 'completed',   label: 'Завершено' },
  { key: 'no_deal',     label: 'Не домовились' },
];

const stageLabel: Record<string, string> = {
  new: 'Новий',
  negotiation: 'Переговори',
  trial: 'Тестовий',
  active: 'Ретеншин',
  completed: 'Завершено',
  no_deal: 'Не домовились',
};

const stageBadge: Record<string, string> = {
  new:         'bg-gray-700/60 text-gray-300 border-gray-600',
  negotiation: 'bg-warning/20 text-warning border-warning/30',
  trial:       'bg-purple-500/20 text-purple-400 border-purple-500/30',
  active:      'bg-success/20 text-success border-success/30',
  completed:   'bg-blue-500/20 text-blue-400 border-blue-500/30',
  no_deal:     'bg-danger/20 text-danger border-danger/30',
};

function calcRevenue(deal: any): number | null {
  const type = deal.deal_type ?? 'CPA';
  const hasActuals = deal.actual_spend != null || deal.actual_conversions != null || deal.actual_revenue != null;
  if (hasActuals) {
    if (type === 'CPA' && deal.actual_conversions != null) return deal.cpa_payout * deal.actual_conversions;
    if (type === 'RevShare' && deal.actual_revenue != null) return deal.revshare_pct / 100 * deal.actual_revenue;
    if (type === 'Spend' && deal.actual_spend != null) return deal.revshare_pct / 100 * deal.actual_spend;
  }
  // planned
  if (type === 'CPA') return deal.cpa_payout * deal.expected_conversions;
  if (type === 'RevShare') return deal.revshare_pct / 100 * (deal.expected_conversions * deal.avg_revenue_per_user);
  if (type === 'Spend') return deal.revshare_pct / 100 * deal.planned_spend;
  return null;
}

function calcAccountsFee(deal: any): number {
  const spend = deal.actual_spend ?? deal.planned_spend ?? 0;
  return (deal.accounts_fee_pct ?? 0) / 100 * spend;
}

function calcNet(deal: any): number | null {
  const rev = calcRevenue(deal);
  if (rev == null) return null;
  return rev - (deal.buyer_fee ?? 0) - (deal.side_costs ?? 0) - calcAccountsFee(deal);
}

function fmt(n: number) { return '$' + n.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }

const dealTypeLabel: Record<string, string> = { CPA: 'CPA', RevShare: 'RevShare', Spend: '% of Spend' };
---

<Layout title="Deals">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Deals</h1>
      <p class="text-gray-500 text-sm mt-1">Buyer–Operator partnerships, pipeline & economics</p>
    </div>
    <button id="toggle-form" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
      + New Deal
    </button>
  </div>

  {createError && (
    <div class="mb-4 bg-danger/10 border border-danger/30 text-danger text-sm rounded-lg px-4 py-3">
      <strong>DB Error:</strong> {createError}
      <p class="text-xs mt-1 text-danger/70">Можливо, не вистачає колонок у таблиці. Запустіть SQL-міграцію (див. нижче).</p>
    </div>
  )}

  <!-- New deal form (hidden by default) -->
  <div id="new-deal-form" class="hidden mb-6 bg-card rounded-xl border border-border p-6">
    <h2 class="font-semibold mb-5 text-base">New Deal</h2>
    <form method="POST" id="create-deal-form">
      <input type="hidden" name="_action" value="create" />
      <!-- buyer_fee in dollars — computed from % on submit -->
      <input type="hidden" name="buyer_fee" id="buyer-fee-hidden" value="0" />

      <!-- Row 1: Buyer + Operator (searchable) -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <!-- Buyer searchable dropdown -->
        <div>
          <label class="block text-xs text-gray-500 mb-1">Buyer</label>
          <div class="relative" id="buyer-wrapper">
            <input type="text" id="buyer-search" placeholder="Search buyer…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="buyer_id" id="buyer-id-input" required />
            <div id="buyer-dd"
              class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-2xl max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>

        <!-- Operator searchable dropdown -->
        <div>
          <label class="block text-xs text-gray-500 mb-1">Operator</label>
          <div class="relative" id="op-wrapper">
            <input type="text" id="op-search" placeholder="Search operator…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="operator_id" id="op-id-input" required />
            <div id="op-dd"
              class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-2xl max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Stage + Deal Type + op_value -->
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Stage</label>
          <select name="pipeline_stage" class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none">
            <option value="new">Новий</option>
            <option value="negotiation">Переговори</option>
            <option value="trial">Тестовий проект</option>
            <option value="active">Ретеншин проект</option>
            <option value="no_deal">Не домовились</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Deal Type (operator pays us)</label>
          <select name="deal_type" id="deal-type-select" class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none">
            <option value="CPA">CPA (per conversion)</option>
            <option value="RevShare">RevShare (% of revenue)</option>
            <option value="Spend">% of Spend (media spend)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1" id="op-value-label">CPA Value ($)</label>
          <input type="number" name="op_value" step="0.01" min="0" placeholder="0"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <!-- Row 3: Planned Spend + Expected Conversions -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Planned Media Spend ($)</label>
          <input type="number" name="planned_spend" id="planned-spend" step="100" min="0" placeholder="10000"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Expected Conversions (FTDs)</label>
          <input type="number" name="expected_conversions" min="0" placeholder="200"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <!-- Row 4: ARPU + Buyer Fee % + accounts fee % -->
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Avg Revenue/User (ARPU) <span class="text-gray-700">RevShare only</span></label>
          <input type="number" name="avg_revenue_per_user" step="0.01" min="0" placeholder="150"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">
            Buyer Fee (%) <span class="text-gray-700">auto-filled from buyer</span>
          </label>
          <div class="relative">
            <input type="number" id="buyer-fee-pct" step="0.1" min="0" max="100" placeholder="0"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 pr-7 text-sm text-gray-200 focus:border-accent outline-none" />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none">%</span>
          </div>
          <p id="buyer-fee-hint" class="text-xs text-gray-700 mt-1 min-h-[1rem]"></p>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Агенські акаунти (%)</label>
          <div class="relative">
            <input type="number" name="accounts_fee_pct" id="accounts-fee-pct" step="0.1" min="0" max="100" placeholder="0"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 pr-7 text-sm text-gray-200 focus:border-accent outline-none" />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none">%</span>
          </div>
        </div>
      </div>

      <!-- Row 5: Інші витрати + GEO tags -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Інші витрати ($) <span class="text-gray-700">tools, misc…</span></label>
          <input type="number" name="side_costs" step="0.01" min="0" placeholder="0"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">GEOs <span class="text-gray-700">DE, AU, NZ…</span></label>
          <div id="geo-list" class="flex flex-wrap items-center gap-1.5 min-h-[38px] bg-card-2 border border-border rounded-lg px-2 py-1.5 focus-within:border-accent">
            <input type="text" id="geo-input" placeholder="Type code + Enter"
              class="flex-1 min-w-[100px] bg-transparent text-sm text-gray-200 placeholder-gray-600 outline-none uppercase" />
          </div>
          <p class="text-[10px] text-gray-700 mt-1">Введіть код (DE, US, ...) і натисніть Enter</p>
        </div>
      </div>

      <div class="mb-5">
        <label class="block text-xs text-gray-500 mb-1">Notes</label>
        <input type="text" name="notes" placeholder="Any extra details…"
          class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
      </div>

      <div class="flex gap-3">
        <button type="submit" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">
          Create Deal
        </button>
        <button type="button" id="cancel-form" class="text-gray-500 hover:text-gray-300 text-sm px-4 py-2 rounded-lg border border-border transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>

  <!-- Stage tabs -->
  <div class="flex gap-1 mb-6 bg-card-2 p-1 rounded-lg w-fit border border-border">
    {stages.map(s => (
      <a href={`/deals${s.key !== 'all' ? `?stage=${s.key}` : ''}`}
        class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
          stageFilter === s.key
            ? 'bg-card text-white shadow'
            : 'text-gray-500 hover:text-gray-300'
        }`}>{s.label}</a>
    ))}
  </div>

  <!-- Deals list -->
  {(!deals || deals.length === 0) ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500 mb-2">No deals yet.</p>
      <p class="text-gray-700 text-sm">Click "+ New Deal" to connect a buyer with an operator.</p>
    </div>
  ) : (
    <div class="space-y-3" id="deals-list">
      {(deals as any[]).map(deal => {
        const rev = calcRevenue(deal);
        const net = calcNet(deal);
        const acctFee = calcAccountsFee(deal);
        const hasActuals = deal.actual_spend != null || deal.actual_conversions != null;
        const stage = deal.pipeline_stage ?? 'new';
        const dtype = deal.deal_type ?? 'CPA';
        const opValue = dtype === 'CPA' ? deal.cpa_payout : deal.revshare_pct;
        const opValueLabel = dtype === 'CPA' ? `$${opValue}/conv` : `${opValue}%`;
        const dealGeos = (deal.geos ?? []);

        // Progress bar: stage progression from "Переговори" → "Тестовий" → "Ретеншин" → "Завершено"
        const progressSteps = [
          { key: 'negotiation', label: 'Переговори', color: 'bg-yellow-500' },
          { key: 'trial',       label: 'Тестовий',   color: 'bg-purple-500' },
          { key: 'active',      label: 'Ретеншин',   color: 'bg-green-500' },
          { key: 'completed',   label: 'Завершено',  color: 'bg-blue-500' },
        ];
        const stageOrder = {
          new: -1, negotiation: 0, trial: 1, active: 2, completed: 3, no_deal: -2,
        };
        const currentStep = stageOrder[stage] ?? -1;
        const isFailed = stage === 'no_deal';

        return (
          <div class="deal-card bg-card rounded-xl border border-border hover:border-accent/20 transition-colors" draggable="true" data-id={deal.id}>
            <!-- Header row -->
            <div class="flex items-center gap-4 p-5">
              <div class="deal-drag-handle text-gray-700 hover:text-gray-400 cursor-grab active:cursor-grabbing select-none text-lg leading-none shrink-0" title="Drag to reorder">⠿</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold">{deal.buyer?.name ?? '—'}</span>
                  <span class="text-gray-600 text-xs">↔</span>
                  <span class="font-semibold">{deal.operator?.name ?? '—'}</span>
                  <span class={`text-xs px-2 py-0.5 rounded border font-medium ${stageBadge[stage] ?? stageBadge.new}`}>
                    {stageLabel[stage] ?? stage}
                  </span>
                  <span class="text-xs px-2 py-0.5 rounded bg-card-2 border border-border text-gray-400">
                    {dealTypeLabel[dtype] ?? dtype} · {opValueLabel}
                  </span>
                  {hasActuals && <span class="text-xs text-gray-600">● actual</span>}
                </div>
                <!-- Economics strip -->
                <div class="flex items-center gap-5 mt-2 text-sm flex-wrap">
                  <span class="text-gray-500">
                    Spend: <span class="text-gray-300 font-mono">{hasActuals && deal.actual_spend != null ? fmt(deal.actual_spend) : fmt(deal.planned_spend)}</span>
                  </span>
                  {deal.buyer_fee > 0 && (
                    <span class="text-gray-500">
                      Buyer fee: <span class="text-gray-300 font-mono">{fmt(deal.buyer_fee)}</span>
                    </span>
                  )}
                  {deal.side_costs > 0 && (
                    <span class="text-gray-500">
                      Витрати: <span class="text-gray-300 font-mono">{fmt(deal.side_costs)}</span>
                    </span>
                  )}
                  {acctFee > 0 && (
                    <span class="text-gray-500">
                      Акаунти: <span class="text-gray-300 font-mono">{fmt(acctFee)}</span>
                      <span class="text-gray-700 text-xs ml-0.5">({deal.accounts_fee_pct}%)</span>
                    </span>
                  )}
                  {rev != null && (
                    <span class="text-gray-500">
                      Revenue: <span class="font-mono text-gray-300">{fmt(rev)}</span>
                    </span>
                  )}
                  {net != null && (
                    <span class={`font-semibold font-mono ${net >= 0 ? 'text-success' : 'text-danger'}`}>
                      Net: {net >= 0 ? '+' : ''}{fmt(net)}
                    </span>
                  )}
                </div>

                <!-- Progress bar -->
                {!isFailed ? (
                  <div class="mt-3">
                    <div class="flex h-1.5 rounded-full overflow-hidden bg-card-2 gap-0.5">
                      {progressSteps.map((step, i) => (
                        <div class={`flex-1 transition-all ${i <= currentStep ? step.color : 'bg-card-2'}`}></div>
                      ))}
                    </div>
                    <div class="flex justify-between mt-1 text-[10px]">
                      {progressSteps.map((step, i) => (
                        <span class={`${i === currentStep ? 'text-gray-200 font-semibold' : i < currentStep ? 'text-gray-500' : 'text-gray-700'}`}>
                          {step.label}
                        </span>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class="mt-3 text-xs text-danger flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-danger inline-block"></span>
                    Не домовились — угода не відбулась
                  </div>
                )}

                <!-- GEOs row -->
                {dealGeos.length > 0 && (
                  <div class="flex items-center gap-1.5 mt-2.5 flex-wrap">
                    <span class="text-[10px] text-gray-700 uppercase tracking-wide">GEO:</span>
                    {dealGeos.map((g: string) => (
                      <span class="text-[10px] font-mono bg-card-2 border border-border px-1.5 py-0.5 rounded text-gray-400 leading-none">{g}</span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Stage change -->
              <form method="POST" class="flex items-center gap-1 shrink-0">
                <input type="hidden" name="_action" value="update_stage" />
                <input type="hidden" name="deal_id" value={deal.id} />
                <select name="stage" onchange="this.form.submit()"
                  class="bg-card-2 border border-border rounded-lg px-2 py-1.5 text-xs text-gray-300 focus:border-accent outline-none">
                  {[
                    ['new','New'],['negotiation','Negotiation'],['trial','Trial'],
                    ['active','Active'],['completed','Completed'],['no_deal','No Deal']
                  ].map(([val, label]) => (
                    <option value={val} selected={val === stage}>{stageLabel[val] ?? label}</option>
                  ))}
                </select>
              </form>

              <!-- Toggle expand -->
              <button class="expand-btn text-gray-600 hover:text-gray-300 text-lg transition-colors shrink-0" data-id={deal.id}>
                ⌄
              </button>
            </div>

            <!-- Expandable: update actuals + delete -->
            <div id={`expand-${deal.id}`} class="hidden border-t border-border p-5">
              <!-- Delete form lives outside the actuals form to avoid nesting -->
              <form method="POST" id={`delete-form-${deal.id}`}>
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="deal_id" value={deal.id} />
              </form>

              <form method="POST" class="grid grid-cols-2 gap-4">
                <input type="hidden" name="_action" value="update_actuals" />
                <input type="hidden" name="deal_id" value={deal.id} />

                <div class="col-span-2">
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Actual Results</p>
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Actual Spend ($)</label>
                  <input type="number" name="actual_spend" step="0.01" value={deal.actual_spend ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Actual Conversions</label>
                  <input type="number" name="actual_conversions" value={deal.actual_conversions ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">
                    {dtype === 'RevShare' ? 'Operator Revenue ($)' : dtype === 'Spend' ? 'Total Spend Billed ($)' : 'Actual Revenue ($)'}
                  </label>
                  <input type="number" name="actual_revenue" step="0.01" value={deal.actual_revenue ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Notes</label>
                  <input type="text" name="notes" value={deal.notes ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>

                <!-- GEOs (edit) -->
                <div class="col-span-2">
                  <label class="block text-xs text-gray-500 mb-1">GEOs</label>
                  <div class="geo-list-edit flex flex-wrap items-center gap-1.5 min-h-[36px] bg-card-2 border border-border rounded-lg px-2 py-1 focus-within:border-accent" data-initial={JSON.stringify(dealGeos)}>
                    <input type="text" class="geo-input-edit flex-1 min-w-[100px] bg-transparent text-sm text-gray-200 placeholder-gray-600 outline-none uppercase" placeholder="Type code + Enter" />
                  </div>
                </div>

                <div class="col-span-2 border-t border-border/40 pt-3 mt-1">
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Costs</p>
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Buyer Fee ($)</label>
                  <input type="number" name="buyer_fee" step="0.01" value={deal.buyer_fee ?? 0}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Інші витрати ($) <span class="text-gray-700">tools, misc…</span></label>
                  <input type="number" name="side_costs" step="0.01" value={deal.side_costs ?? 0}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Агенські акаунти (%)</label>
                  <div class="relative">
                    <input type="number" name="accounts_fee_pct" step="0.1" min="0" max="100" value={deal.accounts_fee_pct ?? 0}
                      class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 pr-7 text-sm text-gray-200 focus:border-accent outline-none" />
                    <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none">%</span>
                  </div>
                </div>

                <div class="col-span-2 flex items-center justify-between pt-1">
                  <button type="submit" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">
                    Save
                  </button>
                  <button
                    type="submit"
                    form={`delete-form-${deal.id}`}
                    onclick="return confirm('Delete this deal?')"
                    class="text-danger hover:bg-danger/10 text-sm px-3 py-1.5 rounded-lg border border-danger/20 transition-colors">
                    Delete Deal
                  </button>
                </div>
              </form>

              <!-- File attachments -->
              <div class="mt-4 pt-4 border-t border-border/50">
                <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Attachments</p>
                <div class="grid grid-cols-2 gap-4">
                  <!-- Deal Terms -->
                  <div>
                    <p class="text-xs text-gray-600 mb-1.5">Deal Terms / Offer</p>
                    {deal.deal_terms_url ? (
                      <div class="flex items-center gap-2">
                        <a href={deal.deal_terms_url} target="_blank" class="text-xs text-accent hover:underline flex items-center gap-1">
                          <span>📄</span> View file
                        </a>
                        <span class="text-gray-700 text-xs">·</span>
                        <label class="text-xs text-gray-500 hover:text-gray-300 cursor-pointer transition-colors">
                          Replace
                          <input type="file" class="hidden upload-input" data-deal={deal.id} data-type="deal_terms" />
                        </label>
                      </div>
                    ) : (
                      <label class="flex items-center gap-2 border border-dashed border-border hover:border-accent/40 rounded-lg px-3 py-2 cursor-pointer transition-colors group upload-zone" data-deal={deal.id} data-type="deal_terms">
                        <span class="text-gray-600 group-hover:text-accent transition-colors text-base">↑</span>
                        <span class="text-xs text-gray-600 group-hover:text-gray-400 transition-colors">Upload terms / PDF</span>
                        <input type="file" class="hidden upload-input" data-deal={deal.id} data-type="deal_terms" />
                      </label>
                    )}
                  </div>
                  <!-- Invoice -->
                  <div>
                    <p class="text-xs text-gray-600 mb-1.5">Invoice</p>
                    {deal.invoice_url ? (
                      <div class="flex items-center gap-2">
                        <a href={deal.invoice_url} target="_blank" class="text-xs text-accent hover:underline flex items-center gap-1">
                          <span>🧾</span> View file
                        </a>
                        <span class="text-gray-700 text-xs">·</span>
                        <label class="text-xs text-gray-500 hover:text-gray-300 cursor-pointer transition-colors">
                          Replace
                          <input type="file" class="hidden upload-input" data-deal={deal.id} data-type="invoice" />
                        </label>
                      </div>
                    ) : (
                      <label class="flex items-center gap-2 border border-dashed border-border hover:border-accent/40 rounded-lg px-3 py-2 cursor-pointer transition-colors group upload-zone" data-deal={deal.id} data-type="invoice">
                        <span class="text-gray-600 group-hover:text-accent transition-colors text-base">↑</span>
                        <span class="text-xs text-gray-600 group-hover:text-gray-400 transition-colors">Upload invoice / PDF</span>
                        <input type="file" class="hidden upload-input" data-deal={deal.id} data-type="invoice" />
                      </label>
                    )}
                  </div>
                </div>
              </div>

              <!-- Reports link -->
              <div class="mt-4 pt-4 border-t border-border/50">
                <a href={`/reports/${deal.id}`}
                  class="inline-flex items-center gap-2 text-sm font-medium bg-accent/15 hover:bg-accent text-accent hover:text-white border border-accent/30 hover:border-accent px-4 py-2 rounded-lg transition-all">
                  📊 Open Daily Reports
                </a>
                <span class="text-xs text-gray-700 ml-3">Excel-style reports per day/week/month</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</Layout>

<script define:vars={{ buyersJson, operatorsJson }}>
  // ── Searchable dropdown factory ────────────────────────────────────────
  function setupSearchable(inputId, dropdownId, hiddenId, data, onSelect) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    const hidden = document.getElementById(hiddenId);
    if (!input || !dropdown || !hidden) return;

    function renderList(query) {
      const q = (query || '').toLowerCase();
      const filtered = q
        ? data.filter(d => d.name.toLowerCase().includes(q))
        : data;
      if (!filtered.length) {
        dropdown.innerHTML = '<div class="px-3 py-2.5 text-xs text-gray-600 italic">No results</div>';
      } else {
        dropdown.innerHTML = filtered.map(d => {
          const name = d.name.replace(/</g, '&lt;').replace(/>/g, '&gt;');
          return `<div class="px-3 py-2 text-sm text-gray-200 hover:bg-accent/10 cursor-pointer transition-colors border-b border-border/40 last:border-0"
            data-id="${d.id}" data-name="${encodeURIComponent(d.name)}">${name}</div>`;
        }).join('');
      }
    }

    input.addEventListener('focus', () => {
      renderList(input.value);
      dropdown.classList.remove('hidden');
    });
    input.addEventListener('input', () => {
      hidden.value = '';
      renderList(input.value);
      dropdown.classList.remove('hidden');
    });
    // Use mousedown so it fires before blur
    dropdown.addEventListener('mousedown', (e) => {
      const item = e.target.closest('[data-id]');
      if (!item) return;
      e.preventDefault();
      hidden.value = item.dataset.id;
      input.value = decodeURIComponent(item.dataset.name);
      dropdown.classList.add('hidden');
      if (onSelect) onSelect(item.dataset.id);
    });
    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!input.parentElement?.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  const buyersData = JSON.parse(buyersJson);
  const operatorsData = JSON.parse(operatorsJson);

  // ── Buyer fee auto-fill ────────────────────────────────────────────────
  function getBuyerFeePct() {
    return Number(document.getElementById('buyer-fee-pct')?.value) || 0;
  }
  function getPlannedSpend() {
    return Number(document.getElementById('planned-spend')?.value) || 0;
  }
  function updateBuyerFeeHint() {
    const pct = getBuyerFeePct();
    const spend = getPlannedSpend();
    const hint = document.getElementById('buyer-fee-hint');
    const hidden = document.getElementById('buyer-fee-hidden');
    if (pct > 0 && spend > 0) {
      const dollars = Math.round(pct / 100 * spend);
      if (hint) hint.textContent = `≈ $${dollars.toLocaleString()} від спенда`;
      if (hidden) hidden.value = String(dollars);
    } else if (pct > 0) {
      if (hint) hint.textContent = 'Вкажіть planned spend для розрахунку';
      if (hidden) hidden.value = '0';
    } else {
      if (hint) hint.textContent = '';
      if (hidden) hidden.value = '0';
    }
  }

  document.getElementById('buyer-fee-pct')?.addEventListener('input', updateBuyerFeeHint);
  document.getElementById('planned-spend')?.addEventListener('input', updateBuyerFeeHint);

  // Setup buyer dropdown — auto-fill buyer_fee_pct on selection
  setupSearchable('buyer-search', 'buyer-dd', 'buyer-id-input', buyersData, (buyerId) => {
    const buyer = buyersData.find(b => b.id === buyerId);
    if (!buyer) return;
    const pctInput = document.getElementById('buyer-fee-pct');
    if (
      pctInput &&
      buyer.compensation_model === '% Spend' &&
      buyer.cooperation_model_value != null
    ) {
      pctInput.value = buyer.cooperation_model_value;
      updateBuyerFeeHint();
    }
  });

  // Setup operator dropdown
  setupSearchable('op-search', 'op-dd', 'op-id-input', operatorsData, null);

  // On form submit: ensure buyer_fee hidden has correct dollar value
  document.getElementById('create-deal-form')?.addEventListener('submit', (e) => {
    updateBuyerFeeHint(); // final sync before submit
  });

  // ── Toggle new deal form ───────────────────────────────────────────────
  document.getElementById('toggle-form')?.addEventListener('click', () => {
    document.getElementById('new-deal-form')?.classList.toggle('hidden');
  });
  document.getElementById('cancel-form')?.addEventListener('click', () => {
    document.getElementById('new-deal-form')?.classList.add('hidden');
  });

  // ── Deal type label update ─────────────────────────────────────────────
  const dealTypeSelect = document.getElementById('deal-type-select');
  const opValueLabel = document.getElementById('op-value-label');
  dealTypeSelect?.addEventListener('change', () => {
    const v = dealTypeSelect.value;
    if (opValueLabel) {
      opValueLabel.textContent = v === 'CPA' ? 'CPA Value ($)' : v === 'RevShare' ? 'RevShare %' : 'Spend %';
    }
  });

  // ── Expand/collapse deal rows ──────────────────────────────────────────
  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      const panel = document.getElementById(`expand-${id}`);
      const expanded = !panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden');
      btn.textContent = expanded ? '⌄' : '⌃';
    });
  });

  // ── File upload ────────────────────────────────────────────────────────
  document.querySelectorAll('.upload-input').forEach(input => {
    input.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const dealId = input.dataset.deal;
      const fileType = input.dataset.type;
      const label = input.closest('label');
      if (label) label.textContent = '⏳ Uploading…';

      const fd = new FormData();
      fd.append('file', file);
      fd.append('deal_id', dealId);
      fd.append('file_type', fileType);

      const res = await fetch('/api/upload-deal-file', { method: 'POST', body: fd });
      if (res.ok) {
        const toast = document.getElementById('copy-toast');
        if (toast) { toast.textContent = '✓ File uploaded'; toast.style.opacity = '1'; setTimeout(() => toast.style.opacity = '0', 2500); }
        setTimeout(() => window.location.reload(), 600);
      } else {
        const err = await res.json();
        alert('Upload failed: ' + (err.error ?? 'Unknown error'));
        if (label) label.textContent = '↑ Upload failed — retry';
      }
    });
  });

  // ── GEO multi-tag input (create form) ─────────────────────────────────
  function setupGeoInput(listEl, inputEl, initialTags = []) {
    function makeChip(code) {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1 bg-accent/15 border border-accent/30 text-accent text-xs font-mono px-1.5 py-0.5 rounded';
      chip.innerHTML = `<span>${code}</span><button type="button" class="hover:text-white text-xs leading-none">×</button>`;
      chip.querySelector('button').addEventListener('click', () => {
        chip.previousSibling?.remove?.(); // hidden input
        chip.remove();
      });
      // Hidden input so form submission includes the geo
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'geos';
      hidden.value = code;
      listEl.insertBefore(hidden, inputEl);
      listEl.insertBefore(chip, inputEl);
    }
    // Initial
    initialTags.forEach(t => makeChip(t));

    inputEl.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ',' || e.key === ' ') {
        e.preventDefault();
        const val = inputEl.value.trim().toUpperCase();
        if (val && val.length <= 5 && !Array.from(listEl.querySelectorAll('input[name="geos"]')).some(i => i.value === val)) {
          makeChip(val);
        }
        inputEl.value = '';
      } else if (e.key === 'Backspace' && !inputEl.value) {
        // remove last chip
        const chips = listEl.querySelectorAll('span.inline-flex');
        const lastChip = chips[chips.length - 1];
        if (lastChip) {
          lastChip.previousSibling?.remove?.();
          lastChip.remove();
        }
      }
    });
  }

  // Create form
  const createGeoList  = document.getElementById('geo-list');
  const createGeoInput = document.getElementById('geo-input');
  if (createGeoList && createGeoInput) setupGeoInput(createGeoList, createGeoInput);

  // Edit forms (per deal)
  document.querySelectorAll('.geo-list-edit').forEach(listEl => {
    const inputEl = listEl.querySelector('.geo-input-edit');
    const initial = JSON.parse(listEl.dataset.initial || '[]');
    if (inputEl) setupGeoInput(listEl, inputEl, initial);
  });

  // ── Drag and drop ─────────────────────────────────────────────────────
  const dealsList = document.getElementById('deals-list');
  let dragSrc = null;

  if (dealsList) {
    dealsList.addEventListener('dragstart', (e) => {
      const card = e.target.closest('.deal-card');
      if (!card) return;
      dragSrc = card;
      card.style.opacity = '0.4';
      e.dataTransfer.effectAllowed = 'move';
    });
    dealsList.addEventListener('dragend', (e) => {
      const card = e.target.closest('.deal-card');
      if (card) card.style.opacity = '';
      dragSrc = null;
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
    });
    dealsList.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const card = e.target.closest('.deal-card');
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
      if (card && card !== dragSrc) card.classList.add('ring-2', 'ring-accent/50');
    });
    dealsList.addEventListener('drop', (e) => {
      e.preventDefault();
      const target = e.target.closest('.deal-card');
      if (!target || target === dragSrc || !dragSrc) return;
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
      const rect = target.getBoundingClientRect();
      dealsList.insertBefore(dragSrc, e.clientY < rect.top + rect.height / 2 ? target : target.nextSibling);
      const ids = [...document.querySelectorAll('.deal-card')].map(c => c.dataset.id).filter(Boolean);
      fetch('/api/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ table: 'projects', ids }),
      });
    });
  }
</script>
