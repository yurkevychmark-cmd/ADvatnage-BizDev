  )}
</Layout>

<script define:vars={{ buyersJson, operatorsJson }}>
  // ── Searchable dropdown factory ────────────────────────────────────────
  function setupSearchable(inputId, dropdownId, hiddenId, data, onSelect) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    const hidden = document.getElementById(hiddenId);
    if (!input || !dropdown || !hidden) return;

    function renderList(query) {
      const q = (query || '').toLowerCase();
      const filtered = q
        ? data.filter(d => d.name.toLowerCase().includes(q))
        : data;
      if (!filtered.length) {
        dropdown.innerHTML = '<div class="px-3 py-2.5 text-xs text-gray-600 italic">No results</div>';
      } else {
        dropdown.innerHTML = filtered.map(d => {
          const name = d.name.replace(/</g, '&lt;').replace(/>/g, '&gt;');
          return `<div class="px-3 py-2 text-sm text-gray-200 hover:bg-accent/10 cursor-pointer transition-colors border-b border-border/40 last:border-0"
            data-id="${d.id}" data-name="${encodeURIComponent(d.name)}">${name}</div>`;
        }).join('');
      }
    }

    input.addEventListener('focus', () => {
      renderList(input.value);
      dropdown.classList.remove('hidden');
    });
    input.addEventListener('input', () => {
      hidden.value = '';
      renderList(input.value);
      dropdown.classList.remove('hidden');
    });
    // Use mousedown so it fires before blur
    dropdown.addEventListener('mousedown', (e) => {
      const item = e.target.closest('[data-id]');
      if (!item) return;
      e.preventDefault();
      hidden.value = item.dataset.id;
      input.value = decodeURIComponent(item.dataset.name);
      dropdown.classList.add('hidden');
      if (onSelect) onSelect(item.dataset.id);
    });
    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!input.parentElement?.contains(e.target)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  const buyersData = JSON.parse(buyersJson);
  const operatorsData = JSON.parse(operatorsJson);

  // ── Buyer fee auto-fill ────────────────────────────────────────────────
  function getBuyerFeePct() {
    return Number(document.getElementById('buyer-fee-pct')?.value) || 0;
  }
  function getPlannedSpend() {
    return Number(document.getElementById('planned-spend')?.value) || 0;
  }
  function updateBuyerFeeHint() {
    const pct = getBuyerFeePct();
    const spend = getPlannedSpend();
    const hint = document.getElementById('buyer-fee-hint');
    const hidden = document.getElementById('buyer-fee-hidden');
    if (pct > 0 && spend > 0) {
      const dollars = Math.round(pct / 100 * spend);
      if (hint) hint.textContent = `≈ $${dollars.toLocaleString()} of spend`;
      if (hidden) hidden.value = String(dollars);
    } else if (pct > 0) {
      if (hint) hint.textContent = 'Enter planned spend to calculate';
      if (hidden) hidden.value = '0';
    } else {
      if (hint) hint.textContent = '';
      if (hidden) hidden.value = '0';
    }
  }

  document.getElementById('buyer-fee-pct')?.addEventListener('input', updateBuyerFeeHint);
  document.getElementById('planned-spend')?.addEventListener('input', updateBuyerFeeHint);

  // Setup buyer dropdown — auto-fill buyer_fee_pct on selection
  setupSearchable('buyer-search', 'buyer-dd', 'buyer-id-input', buyersData, (buyerId) => {
    const buyer = buyersData.find(b => b.id === buyerId);
    if (!buyer) return;
    const pctInput = document.getElementById('buyer-fee-pct');
    if (
      pctInput &&
      buyer.compensation_model === '% Spend' &&
      buyer.cooperation_model_value != null
    ) {
      pctInput.value = buyer.cooperation_model_value;
      updateBuyerFeeHint();
    }
  });

  // Setup operator dropdown
  setupSearchable('op-search', 'op-dd', 'op-id-input', operatorsData, null);

  // On form submit: ensure buyer_fee hidden has correct dollar value
  document.getElementById('create-deal-form')?.addEventListener('submit', (e) => {
    updateBuyerFeeHint(); // final sync before submit
  });

  // ── Toggle new deal form ───────────────────────────────────────────────
  document.getElementById('toggle-form')?.addEventListener('click', () => {
    document.getElementById('new-deal-form')?.classList.toggle('hidden');
  });
  document.getElementById('cancel-form')?.addEventListener('click', () => {
    document.getElementById('new-deal-form')?.classList.add('hidden');
  });

  // ── Deal type label update ─────────────────────────────────────────────
  const dealTypeSelect = document.getElementById('deal-type-select');
  const opValueLabel = document.getElementById('op-value-label');
  dealTypeSelect?.addEventListener('change', () => {
    const v = dealTypeSelect.value;
    if (opValueLabel) {
      opValueLabel.textContent = v === 'CPA' ? 'CPA Value ($)' : v === 'RevShare' ? 'RevShare %' : 'Spend %';
    }
  });

  // ── Expand/collapse deal rows ──────────────────────────────────────────
  document.querySelectorAll('.expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      const panel = document.getElementById(`expand-${id}`);
      const expanded = !panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden');
      btn.textContent = expanded ? '⌄' : '⌃';
    });
  });

  // ── File upload ────────────────────────────────────────────────────────
  document.querySelectorAll('.upload-input').forEach(input => {
    input.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const dealId = input.dataset.deal;
      const fileType = input.dataset.type;
      const label = input.closest('label');
      if (label) label.textContent = '⏳ Uploading…';

      const fd = new FormData();
      fd.append('file', file);
      fd.append('deal_id', dealId);
      fd.append('file_type', fileType);

      const res = await fetch('/api/upload-deal-file', { method: 'POST', body: fd });
      if (res.ok) {
        const toast = document.getElementById('copy-toast');
        if (toast) { toast.textContent = '✓ File uploaded'; toast.style.opacity = '1'; setTimeout(() => toast.style.opacity = '0', 2500); }
        setTimeout(() => window.location.reload(), 600);
      } else {
        const err = await res.json();
        alert('Upload failed: ' + (err.error ?? 'Unknown error'));
        if (label) label.textContent = '↑ Upload failed — retry';
      }
    });
  });

  // ── GEO multi-tag input (create form) ─────────────────────────────────
  function setupGeoInput(listEl, inputEl, initialTags = []) {
    function makeChip(code) {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1 bg-accent/15 border border-accent/30 text-accent text-xs font-mono px-1.5 py-0.5 rounded';
      chip.innerHTML = `<span>${code}</span><button type="button" class="hover:text-white text-xs leading-none">×</button>`;
      chip.querySelector('button').addEventListener('click', () => {
        chip.previousSibling?.remove?.(); // hidden input
        chip.remove();
      });
      // Hidden input so form submission includes the geo
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'geos';
      hidden.value = code;
      listEl.insertBefore(hidden, inputEl);
      listEl.insertBefore(chip, inputEl);
    }
    // Initial
    initialTags.forEach(t => makeChip(t));

    inputEl.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ',' || e.key === ' ') {
        e.preventDefault();
        const val = inputEl.value.trim().toUpperCase();
        if (val && val.length <= 5 && !Array.from(listEl.querySelectorAll('input[name="geos"]')).some(i => i.value === val)) {
          makeChip(val);
        }
        inputEl.value = '';
      } else if (e.key === 'Backspace' && !inputEl.value) {
        // remove last chip
        const chips = listEl.querySelectorAll('span.inline-flex');
        const lastChip = chips[chips.length - 1];
        if (lastChip) {
          lastChip.previousSibling?.remove?.();
          lastChip.remove();
        }
      }
    });
  }

  // Create form
  const createGeoList  = document.getElementById('geo-list');
  const createGeoInput = document.getElementById('geo-input');
  if (createGeoList && createGeoInput) setupGeoInput(createGeoList, createGeoInput);

  // Edit forms (per deal)
  document.querySelectorAll('.geo-list-edit').forEach(listEl => {
    const inputEl = listEl.querySelector('.geo-input-edit');
    const initial = JSON.parse(listEl.dataset.initial || '[]');
    if (inputEl) setupGeoInput(listEl, inputEl, initial);
  });

  // ── Drag and drop ─────────────────────────────────────────────────────
  const dealsList = document.getElementById('deals-list');
  let dragSrc = null;

  if (dealsList) {
    dealsList.addEventListener('dragstart', (e) => {
      const card = e.target.closest('.deal-card');
      if (!card) return;
      dragSrc = card;
      card.style.opacity = '0.4';
      e.dataTransfer.effectAllowed = 'move';
    });
    dealsList.addEventListener('dragend', (e) => {
      const card = e.target.closest('.deal-card');
      if (card) card.style.opacity = '';
      dragSrc = null;
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
    });
    dealsList.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const card = e.target.closest('.deal-card');
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
      if (card && card !== dragSrc) card.classList.add('ring-2', 'ring-accent/50');
    });
    dealsList.addEventListener('drop', (e) => {
      e.preventDefault();
      const target = e.target.closest('.deal-card');
      if (!target || target === dragSrc || !dragSrc) return;
      document.querySelectorAll('.deal-card').forEach(c => c.classList.remove('ring-2', 'ring-accent/50'));
      const rect = target.getBoundingClientRect();
      dealsList.insertBefore(dragSrc, e.clientY < rect.top + rect.height / 2 ? target : target.nextSibling);
      const ids = [...document.querySelectorAll('.deal-card')].map(c => c.dataset.id).filter(Boolean);
      fetch('/api/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ table: 'projects', ids }),
      });
    });
  }
</script>

<script>
  // ── Агент по угоді (таск 1dcedada): наступний дотик, пауза, вкладка «Розмова» ─────────────
  type State = { project_id: string; next_touch_at: string | null; agent_paused: boolean; unanswered_touches: number; linked_chats: number };
  type Item = { key: string; kind: 'message' | 'draft' | 'note'; at: string; chat?: string | null; side?: string | null; author?: string | null; outgoing?: boolean; text: string; media?: string | null; status?: string; why?: string | null };

  const POLL_MS = 5000;
  const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const fmtAt = (iso: string | null) => (iso ? new Date(iso).toLocaleString('uk-UA', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—');
  // ISO → значення для <input type="datetime-local"> у часовому поясі браузера
  const toLocalInput = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso);
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  };
  const q = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const qa = <T extends Element>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

  function toast(text: string) {
    const t = document.getElementById('copy-toast');
    if (!t) return;
    t.textContent = text;
    t.style.opacity = '1';
    setTimeout(() => (t.style.opacity = '0'), 2500);
  }

  function paintPause(btn: HTMLElement, paused: boolean) {
    btn.dataset.paused = String(paused);
    btn.textContent = paused ? '⏸ Пауза агента: увімкнено' : '▶ Пауза агента: вимкнено';
    btn.className = `agent-pause-btn px-2 py-0.5 rounded border transition-colors ${paused ? 'bg-warning/20 text-warning border-warning/40' : 'text-gray-500 border-border hover:text-gray-300'}`;
    btn.title = paused ? 'Агент по цій угоді мовчить. Натисніть, щоб зняти паузу.' : 'Натисніть, щоб агент по цій угоді замовк.';
  }

  function applyState(s: State | null) {
    if (!s) return;
    const strip = q<HTMLElement>(`.deal-agent-strip[data-id="${s.project_id}"]`);
    if (!strip) return;
    const next = q<HTMLElement>('.agent-next', strip)!;
    next.dataset.at = s.next_touch_at ?? '';
    next.textContent = fmtAt(s.next_touch_at);
    const un = q<HTMLElement>('.agent-unanswered', strip)!;
    un.textContent = String(s.unanswered_touches ?? 0);
    un.className = `agent-unanswered font-mono ${s.unanswered_touches > 0 ? 'text-warning' : 'text-gray-300'}`;
    paintPause(q<HTMLElement>('.agent-pause-btn', strip)!, !!s.agent_paused);
  }

  async function saveAgent(id: string, patch: Record<string, unknown>) {
    const res = await fetch('/api/deal-agent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, ...patch }) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) { alert(data.error ?? 'Не вдалося зберегти'); return null; }
    applyState(data.state);
    return data.state as State;
  }

  qa<HTMLElement>('.agent-next').forEach((el) => (el.textContent = fmtAt(el.dataset.at || null)));
  qa<HTMLInputElement>('.agent-next-input').forEach((el) => (el.value = toLocalInput(el.dataset.at || null)));
  qa<HTMLElement>('.agent-pause-btn').forEach((btn) => {
    paintPause(btn, btn.dataset.paused === 'true');
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const paused = btn.dataset.paused !== 'true';
      btn.setAttribute('disabled', '');
      if (await saveAgent(btn.dataset.id!, { agent_paused: paused })) toast(paused ? '⏸ Агент по угоді на паузі' : '▶ Паузу знято');
      btn.removeAttribute('disabled');
    });
  });
  qa<HTMLButtonElement>('.agent-next-save').forEach((btn) => btn.addEventListener('click', async () => {
    const input = q<HTMLInputElement>(`.agent-next-input[data-id="${btn.dataset.id}"]`)!;
    if (!input.value) { alert('Вкажіть дату й час'); return; }
    if (await saveAgent(btn.dataset.id!, { next_touch_at: new Date(input.value).toISOString() })) toast('✓ Наступний дотик збережено');
  }));
  qa<HTMLButtonElement>('.agent-next-clear').forEach((btn) => btn.addEventListener('click', async () => {
    if (await saveAgent(btn.dataset.id!, { next_touch_at: null })) {
      q<HTMLInputElement>(`.agent-next-input[data-id="${btn.dataset.id}"]`)!.value = '';
      toast('✓ Наступний дотик очищено');
    }
  }));

  // ── Вкладки ──
  const conv = new Map<string, { cursor: string | null; keys: Set<string>; timer: number | null; busy: boolean }>();

  function showTab(deal: string, tab: string) {
    qa<HTMLElement>(`.deal-tab[data-deal="${deal}"]`).forEach((b) => {
      const on = b.dataset.tab === tab;
      b.className = `deal-tab text-sm px-3 py-1.5 -mb-px border-b-2 ${on ? 'border-accent text-gray-100' : 'border-transparent text-gray-500 hover:text-gray-300'}`;
    });
    qa<HTMLElement>(`.deal-tab-panel[data-deal="${deal}"]`).forEach((p) => (p.hidden = p.dataset.tab !== tab));
    if (tab === 'conversation') openConversation(deal);
    else stopPolling(deal);
  }
  qa<HTMLElement>('.deal-tab').forEach((b) => b.addEventListener('click', () => showTab(b.dataset.deal!, b.dataset.tab!)));

  // ── Розмова ──
  const sideLabel: Record<string, string> = { buyer: 'баєр', operator: 'оператор' };
  const mediaLabel: Record<string, string> = { photo: 'фото', video: 'відео', voice: 'голосове', document: 'файл', sticker: 'стікер', other: 'вкладення' };
  const draftStatus: Record<string, string> = { draft: 'чернетка', approved: 'погоджено', discarded: 'відхилено', sent: 'надіслано' };

  function itemHtml(i: Item) {
    if (i.kind === 'note') {
      return `<div class="conv-item border border-border/60 bg-card-2/50 rounded-lg px-3 py-2" data-key="${esc(i.key)}" data-at="${esc(i.at)}">
        <div class="text-[11px] text-gray-500 mb-0.5">📝 Нотатка агента · ${fmtAt(i.at)}</div>
        <div class="text-sm text-gray-400 italic whitespace-pre-wrap">${esc(i.text)}</div></div>`;
    }
    if (i.kind === 'draft') {
      return `<div class="conv-item border border-dashed border-warning/40 bg-warning/5 rounded-lg px-3 py-2 ml-10" data-key="${esc(i.key)}" data-at="${esc(i.at)}">
        <div class="text-[11px] text-warning/80 mb-0.5">✎ Чернетка агента (${esc(draftStatus[i.status ?? ''] ?? i.status)})${i.chat ? ` · ${esc(i.chat)}` : ''} · ${fmtAt(i.at)}</div>
        <div class="text-sm text-gray-200 whitespace-pre-wrap">${esc(i.text)}</div>
        ${i.why ? `<div class="text-[11px] text-gray-500 mt-1">Чому: ${esc(i.why)}</div>` : ''}</div>`;
    }
    const media = i.media ? `<span class="text-[11px] text-gray-500">[${esc(mediaLabel[i.media] ?? i.media)}]</span> ` : '';
    return `<div class="conv-item flex ${i.outgoing ? 'justify-end' : ''}" data-key="${esc(i.key)}" data-at="${esc(i.at)}">
      <div class="max-w-[80%] rounded-lg px-3 py-2 ${i.outgoing ? 'bg-accent/15 border border-accent/20' : 'bg-card-2 border border-border'}">
        <div class="text-[11px] text-gray-500 mb-0.5">${esc(i.outgoing ? 'Ми' : i.author ?? '—')}${i.chat ? ` · ${esc(i.chat)}` : ''}${i.side ? ` (${esc(sideLabel[i.side] ?? i.side)})` : ''} · ${fmtAt(i.at)}</div>
        <div class="text-sm text-gray-200 whitespace-pre-wrap break-words">${media}${esc(i.text)}</div>
      </div></div>`;
  }

  function insertItems(deal: string, items: Item[]) {
    const s = conv.get(deal)!;
    const panel = q<HTMLElement>(`.deal-tab-panel[data-deal="${deal}"][data-tab="conversation"]`)!;
    const list = q<HTMLElement>('.conv-list', panel)!;
    const nearBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 80;
    let added = 0;
    for (const i of items) {
      if (s.keys.has(i.key)) continue;
      s.keys.add(i.key);
      added++;
      const html = itemHtml(i);
      // по порядку часу: новий рядок може бути й старішим (слухач дочитав пропущене)
      const after = qa<HTMLElement>('.conv-item', list).reverse().find((el) => Date.parse(el.dataset.at!) <= Date.parse(i.at));
      if (after) after.insertAdjacentHTML('afterend', html);
      else list.insertAdjacentHTML('afterbegin', html);
    }
    q('.conv-empty', list)?.remove();
    if (!s.keys.size) list.innerHTML = '<p class="conv-empty text-sm text-gray-600">Повідомлень ще немає.</p>';
    if (added && nearBottom) list.scrollTop = list.scrollHeight;
    return added;
  }

  async function fetchConversation(deal: string) {
    const s = conv.get(deal)!;
    if (s.busy || document.hidden) return;
    s.busy = true;
    const panel = q<HTMLElement>(`.deal-tab-panel[data-deal="${deal}"][data-tab="conversation"]`)!;
    const status = q<HTMLElement>('.conv-status', panel)!;
    try {
      const res = await fetch(`/api/deal-conversation?deal=${deal}${s.cursor ? `&after=${encodeURIComponent(s.cursor)}` : ''}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? res.status);
      const first = s.cursor === null && s.keys.size === 0;
      if (first) {
        const chats = q<HTMLElement>('.conv-chats', panel)!;
        chats.innerHTML = data.chats.length
          ? 'Чати: ' + data.chats.map((c: any) => `<span class="text-gray-300">${esc(c.title ?? c.chat_id)}</span> (${esc(sideLabel[c.side] ?? c.side)})`).join(', ')
          : 'Чатів не прив\'язано. Прив\'яжіть Telegram-чат у картці баєра чи оператора — розмова з\'явиться тут.';
        if (data.truncated) chats.innerHTML += ' · показано останні 300 повідомлень';
      }
      insertItems(deal, data.items);
      if (first) { const list = q<HTMLElement>('.conv-list', panel)!; list.scrollTop = list.scrollHeight; }
      s.cursor = data.cursor ?? s.cursor;
      applyState(data.state);
      status.textContent = `Оновлюється сама кожні ${POLL_MS / 1000} с · перевірено ${new Date().toLocaleTimeString('uk-UA')}`;
    } catch (e: any) {
      status.textContent = `Не вдалося оновити (${e.message}), повторю за ${POLL_MS / 1000} с`;
    } finally {
      s.busy = false;
    }
  }

  function openConversation(deal: string) {
    if (!conv.has(deal)) conv.set(deal, { cursor: null, keys: new Set(), timer: null, busy: false });
    const s = conv.get(deal)!;
    fetchConversation(deal);
    if (s.timer === null) {
      s.timer = window.setInterval(() => {
        // панель згорнули — більше не опитуємо
        if (document.getElementById(`expand-${deal}`)?.classList.contains('hidden')) return stopPolling(deal);
        fetchConversation(deal);
      }, POLL_MS);
    }
  }

  function stopPolling(deal: string) {
    const s = conv.get(deal);
    if (s?.timer != null) { clearInterval(s.timer); s.timer = null; }
  }

  // Повернулися до розгорнутої угоди з відкритою «Розмовою» — опитування відновлюється.
  qa<HTMLElement>('.expand-btn').forEach((btn) => btn.addEventListener('click', () => {
    const deal = btn.dataset.id!;
    const open = !document.getElementById(`expand-${deal}`)?.classList.contains('hidden');
    const convPanel = q<HTMLElement>(`.deal-tab-panel[data-deal="${deal}"][data-tab="conversation"]`);
    if (open && convPanel && !convPanel.hidden) openConversation(deal);
  }));

  // Виділити й скопіювати текст у розмові: картка вся перетягується, тож на час виділення вимикаємо.
  qa<HTMLElement>('.conv-list').forEach((list) => {
    const card = list.closest<HTMLElement>('.deal-card');
    list.addEventListener('mousedown', () => card && (card.draggable = false));
    document.addEventListener('mouseup', () => card && (card.draggable = true));
  });
</script>
