                  <input type="number" name="actual_spend" step="0.01" value={deal.actual_spend ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Actual Conversions</label>
                  <input type="number" name="actual_conversions" value={deal.actual_conversions ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">
