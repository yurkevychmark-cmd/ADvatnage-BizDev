---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;

  if (action === 'create') {
    const buyerId = form.get('buyer_id') as string;
    const opId = form.get('operator_id') as string;
    const { data: buyer } = await supabase.from('buyers').select('name').eq('id', buyerId).single();
    const { data: op } = await supabase.from('operators').select('name').eq('id', opId).single();
    const dealType = form.get('deal_type') as string;
    const dealName = `${(buyer as any)?.name ?? '?'} ↔ ${(op as any)?.name ?? '?'}`;
    const { error: insertError } = await supabase.from('projects').insert({
      name: dealName,
      buyer_id: buyerId || null,
      operator_id: opId || null,
      pipeline_stage: form.get('pipeline_stage') || 'new',
      deal_type: dealType,
      planned_spend: Number(form.get('planned_spend')) || 0,
      expected_conversions: Number(form.get('expected_conversions')) || 0,
      cpa_payout: dealType === 'CPA' ? Number(form.get('op_value')) || 0 : 0,
      revshare_pct: dealType !== 'CPA' ? Number(form.get('op_value')) || 0 : 0,
      avg_revenue_per_user: Number(form.get('avg_revenue_per_user')) || 0,
      buyer_fee: Number(form.get('buyer_fee')) || 0,
      side_costs: Number(form.get('side_costs')) || 0,
      accounts_fee_pct: Number(form.get('accounts_fee_pct')) || 0,
      geos: (form.getAll('geos') as string[]).filter(g => g.trim().length > 0).map(g => g.trim().toUpperCase()),
      notes: (form.get('notes') as string) || null,
      status: 'active',
    });
    if (insertError) {
      return Astro.redirect(`/deals?error=${encodeURIComponent(insertError.message)}`);
    }
    await supabase.from('activity_log').insert({ entity_type: 'deal', entity_name: dealName, action: 'created' });
  }

  if (action === 'update_stage') {
    const dealId   = form.get('deal_id') as string;
    const newStage = form.get('stage') as string;
    const { data: dealRow } = await supabase.from('projects').select('name, pipeline_stage').eq('id', dealId).single();
    await supabase.from('projects').update({ pipeline_stage: newStage }).eq('id', dealId);
    if (dealRow) {
      const stageLabels: Record<string, string> = {
        new: 'New', negotiation: 'Negotiation', trial: 'Trial',
        active: 'Retention', completed: 'Completed', no_deal: 'No Deal',
      };
      const from = stageLabels[(dealRow as any).pipeline_stage] ?? (dealRow as any).pipeline_stage;
      const to   = stageLabels[newStage] ?? newStage;
      await supabase.from('activity_log').insert({
        entity_type: 'deal',
        entity_name: (dealRow as any).name,
        action: `${from} → ${to}`,
      });
    }
  }

  if (action === 'update_actuals') {
    const editDealType = (form.get('deal_type') as string) || 'CPA';
    const editOpValue  = Number(form.get('op_value')) || 0;
    await supabase.from('projects')
      .update({
        deal_type:          editDealType,
        cpa_payout:         editDealType === 'CPA' ? editOpValue : 0,
        revshare_pct:       editDealType !== 'CPA' ? editOpValue : 0,
        actual_spend:       Number(form.get('actual_spend')) || null,
        actual_conversions: Number(form.get('actual_conversions')) || null,
        actual_revenue:     Number(form.get('actual_revenue')) || null,
        buyer_fee:          Number(form.get('buyer_fee')) || 0,
        side_costs:         Number(form.get('side_costs')) || 0,
        accounts_fee_pct:   Number(form.get('accounts_fee_pct')) || 0,
        geos:               (form.getAll('geos') as string[]).filter(g => g.trim().length > 0).map(g => g.trim().toUpperCase()),
        notes:              (form.get('notes') as string) || null,
      })
      .eq('id', form.get('deal_id') as string);
  }

  if (action === 'delete') {
    await supabase.from('projects').delete().eq('id', form.get('deal_id') as string);
  }

  return Astro.redirect('/deals');
}

const stageFilter = Astro.url.searchParams.get('stage') ?? 'all';
const createError = Astro.url.searchParams.get('error');

const query = supabase
  .from('projects')
  .select('*, buyer:buyers(id,name), operator:operators(id,name,deal_type,cpa_value,revshare_pct,spend_pct)')
  .order('sort_order', { ascending: true, nullsFirst: false })
  .order('created_at', { ascending: false });

if (stageFilter !== 'all') query.eq('pipeline_stage', stageFilter);
const { data: deals } = await query;

// Поля агента по угоді (таск 1dcedada): наступний дотик, дотики без відповіді, пауза.
const { data: agentStates } = await (supabase as any).from('deal_agent_state').select('*');
const agentState = new Map<string, any>((agentStates ?? []).map((s: any) => [s.project_id, s]));

const { data: buyers } = await supabase.from('buyers').select('id, name, compensation_model, cooperation_model_value').order('name');
const { data: operators } = await supabase.from('operators').select('id, name, deal_type, cpa_value, revshare_pct, spend_pct').order('name');

// Serialise for client-side searchable dropdowns
const buyersJson = JSON.stringify(buyers ?? []);
const operatorsJson = JSON.stringify(operators ?? []);

const stages = [
  { key: 'all',         label: 'All' },
  { key: 'new',         label: 'New' },
  { key: 'negotiation', label: 'Negotiation' },
  { key: 'trial',       label: 'Trial' },
  { key: 'active',      label: 'Retention' },
  { key: 'completed',   label: 'Completed' },
  { key: 'no_deal',     label: 'No Deal' },
];

const stageLabel: Record<string, string> = {
  new: 'New',
  negotiation: 'Negotiation',
  trial: 'Trial',
  active: 'Retention',
  completed: 'Completed',
  no_deal: 'No Deal',
};

const stageBadge: Record<string, string> = {
  new:         'bg-gray-700/60 text-gray-300 border-gray-600',
  negotiation: 'bg-warning/20 text-warning border-warning/30',
  trial:       'bg-purple-500/20 text-purple-400 border-purple-500/30',
  active:      'bg-success/20 text-success border-success/30',
  completed:   'bg-blue-500/20 text-blue-400 border-blue-500/30',
  no_deal:     'bg-danger/20 text-danger border-danger/30',
};

function calcRevenue(deal: any): number | null {
  const type = deal.deal_type ?? 'CPA';
  const hasActuals = deal.actual_spend != null || deal.actual_conversions != null || deal.actual_revenue != null;
  if (hasActuals) {
    if (type === 'CPA' && deal.actual_conversions != null) return deal.cpa_payout * deal.actual_conversions;
    if (type === 'RevShare' && deal.actual_revenue != null) return deal.revshare_pct / 100 * deal.actual_revenue;
    if (type === 'Spend' && deal.actual_spend != null) return deal.revshare_pct / 100 * deal.actual_spend;
  }
  // planned
  if (type === 'CPA') return deal.cpa_payout * deal.expected_conversions;
  if (type === 'RevShare') return deal.revshare_pct / 100 * (deal.expected_conversions * deal.avg_revenue_per_user);
  if (type === 'Spend') return deal.revshare_pct / 100 * deal.planned_spend;
  return null;
}

function calcAccountsFee(deal: any): number {
  const spend = deal.actual_spend ?? deal.planned_spend ?? 0;
  return (deal.accounts_fee_pct ?? 0) / 100 * spend;
}

function calcNet(deal: any): number | null {
  const rev = calcRevenue(deal);
  if (rev == null) return null;
  return rev - (deal.buyer_fee ?? 0) - (deal.side_costs ?? 0) - calcAccountsFee(deal);
}

function fmt(n: number) { return '$' + n.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }

const dealTypeLabel: Record<string, string> = { CPA: 'CPA', RevShare: 'RevShare', Spend: '% of Spend' };
---

<Layout title="Deals">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Deals</h1>
      <p class="text-gray-500 text-sm mt-1">Buyer–Operator partnerships, pipeline & economics</p>
    </div>
    <button id="toggle-form" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
      + New Deal
    </button>
  </div>

  {createError && (
    <div class="mb-4 bg-danger/10 border border-danger/30 text-danger text-sm rounded-lg px-4 py-3">
      <strong>DB Error:</strong> {createError}
      <p class="text-xs mt-1 text-danger/70">Possible missing DB columns — run the SQL migration.</p>
    </div>
  )}

  <!-- New deal form (hidden by default) -->
  <div id="new-deal-form" class="hidden mb-6 bg-card rounded-xl border border-border p-6">
    <h2 class="font-semibold mb-5 text-base">New Deal</h2>
    <form method="POST" id="create-deal-form">
      <input type="hidden" name="_action" value="create" />
      <!-- buyer_fee in dollars — computed from % on submit -->
      <input type="hidden" name="buyer_fee" id="buyer-fee-hidden" value="0" />

      <!-- Row 1: Buyer + Operator (searchable) -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <!-- Buyer searchable dropdown -->
        <div>
          <label class="block text-xs text-gray-500 mb-1">Buyer</label>
          <div class="relative" id="buyer-wrapper">
            <input type="text" id="buyer-search" placeholder="Search buyer…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="buyer_id" id="buyer-id-input" required />
            <div id="buyer-dd"
              class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-2xl max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>

        <!-- Operator searchable dropdown -->
        <div>
          <label class="block text-xs text-gray-500 mb-1">Operator</label>
          <div class="relative" id="op-wrapper">
            <input type="text" id="op-search" placeholder="Search operator…" autocomplete="off"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
            <input type="hidden" name="operator_id" id="op-id-input" required />
            <div id="op-dd"
              class="hidden absolute z-50 top-full left-0 right-0 mt-1 bg-card border border-border rounded-lg shadow-2xl max-h-52 overflow-y-auto">
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Stage + Deal Type + op_value -->
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Stage</label>
          <select name="pipeline_stage" class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none">
            <option value="new">New</option>
            <option value="negotiation">Negotiation</option>
            <option value="trial">Trial</option>
            <option value="active">Retention</option>
            <option value="no_deal">No Deal</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Deal Type (operator pays us)</label>
          <select name="deal_type" id="deal-type-select" class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none">
            <option value="CPA">CPA (per conversion)</option>
            <option value="RevShare">RevShare (% of revenue)</option>
            <option value="Spend">% of Spend (media spend)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1" id="op-value-label">CPA Value ($)</label>
          <input type="number" name="op_value" step="0.01" min="0" placeholder="0"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <!-- Row 3: Planned Spend + Expected Conversions -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Planned Media Spend ($)</label>
          <input type="number" name="planned_spend" id="planned-spend" step="100" min="0" placeholder="10000"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Expected Conversions (FTDs)</label>
          <input type="number" name="expected_conversions" min="0" placeholder="200"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
      </div>

      <!-- Row 4: ARPU + Buyer Fee % + accounts fee % -->
      <div class="grid grid-cols-3 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Avg Revenue/User (ARPU) <span class="text-gray-700">RevShare only</span></label>
          <input type="number" name="avg_revenue_per_user" step="0.01" min="0" placeholder="150"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">
            Buyer Fee (%) <span class="text-gray-700">auto-filled from buyer</span>
          </label>
          <div class="relative">
            <input type="number" id="buyer-fee-pct" step="0.1" min="0" max="100" placeholder="0"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 pr-7 text-sm text-gray-200 focus:border-accent outline-none" />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none">%</span>
          </div>
          <p id="buyer-fee-hint" class="text-xs text-gray-700 mt-1 min-h-[1rem]"></p>
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">Agency Accounts (%)</label>
          <div class="relative">
            <input type="number" name="accounts_fee_pct" id="accounts-fee-pct" step="0.1" min="0" max="100" placeholder="0"
              class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 pr-7 text-sm text-gray-200 focus:border-accent outline-none" />
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-gray-600 pointer-events-none">%</span>
          </div>
        </div>
      </div>

      <!-- Row 5: Other costs + GEO tags -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs text-gray-500 mb-1">Other Costs ($) <span class="text-gray-700">tools, misc…</span></label>
          <input type="number" name="side_costs" step="0.01" min="0" placeholder="0"
            class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
        </div>
        <div>
          <label class="block text-xs text-gray-500 mb-1">GEOs <span class="text-gray-700">DE, AU, NZ…</span></label>
          <div id="geo-list" class="flex flex-wrap items-center gap-1.5 min-h-[38px] bg-card-2 border border-border rounded-lg px-2 py-1.5 focus-within:border-accent">
            <input type="text" id="geo-input" placeholder="Type code + Enter"
              class="flex-1 min-w-[100px] bg-transparent text-sm text-gray-200 placeholder-gray-600 outline-none uppercase" />
          </div>
          <p class="text-[10px] text-gray-700 mt-1">Type code (DE, US, …) and press Enter</p>
        </div>
      </div>

      <div class="mb-5">
        <label class="block text-xs text-gray-500 mb-1">Notes</label>
        <input type="text" name="notes" placeholder="Any extra details…"
          class="w-full bg-card-2 border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:border-accent outline-none" />
      </div>

      <div class="flex gap-3">
        <button type="submit" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">
          Create Deal
        </button>
        <button type="button" id="cancel-form" class="text-gray-500 hover:text-gray-300 text-sm px-4 py-2 rounded-lg border border-border transition-colors">
          Cancel
        </button>
      </div>
    </form>
  </div>

  <!-- Stage tabs -->
  <div class="flex gap-1 mb-6 bg-card-2 p-1 rounded-lg w-fit border border-border">
    {stages.map(s => (
      <a href={`/deals${s.key !== 'all' ? `?stage=${s.key}` : ''}`}
        class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
          stageFilter === s.key
            ? 'bg-card text-white shadow'
            : 'text-gray-500 hover:text-gray-300'
        }`}>{s.label}</a>
    ))}
  </div>

  <!-- Deals list -->
  {(!deals || deals.length === 0) ? (
    <div class="bg-card rounded-xl border border-border p-16 text-center">
      <p class="text-gray-500 mb-2">No deals yet.</p>
      <p class="text-gray-700 text-sm">Click "+ New Deal" to connect a buyer with an operator.</p>
    </div>
  ) : (
    <div class="space-y-3" id="deals-list">
      {(deals as any[]).map(deal => {
        const rev = calcRevenue(deal);
        const net = calcNet(deal);
        const acctFee = calcAccountsFee(deal);
        const hasActuals = deal.actual_spend != null || deal.actual_conversions != null;
        const stage = deal.pipeline_stage ?? 'new';
        const dtype = deal.deal_type ?? 'CPA';
        const opValue = dtype === 'CPA' ? deal.cpa_payout : deal.revshare_pct;
        const opValueLabel = dtype === 'CPA' ? `$${opValue}/conv` : `${opValue}%`;
        const dealGeos = (deal.geos ?? []);

        // Progress bar: stage progression
        const progressSteps = [
          { key: 'negotiation', label: 'Negotiation', color: 'bg-yellow-500' },
          { key: 'trial',       label: 'Trial',       color: 'bg-purple-500' },
          { key: 'active',      label: 'Retention',   color: 'bg-green-500' },
          { key: 'completed',   label: 'Completed',   color: 'bg-blue-500' },
        ];
        const stageOrder = {
          new: -1, negotiation: 0, trial: 1, active: 2, completed: 3, no_deal: -2,
        };
        const currentStep = stageOrder[stage] ?? -1;
        const isFailed = stage === 'no_deal';
        const agent = agentState.get(deal.id) ?? {};

        return (
          <div class="deal-card bg-card rounded-xl border border-border hover:border-accent/20 transition-colors" draggable="true" data-id={deal.id}>
            <!-- Header row -->
            <div class="flex items-center gap-4 p-5">
              <div class="deal-drag-handle text-gray-700 hover:text-gray-400 cursor-grab active:cursor-grabbing select-none text-lg leading-none shrink-0" title="Drag to reorder">⠿</div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold">{deal.buyer?.name ?? '—'}</span>
                  <span class="text-gray-600 text-xs">↔</span>
                  <span class="font-semibold">{deal.operator?.name ?? '—'}</span>
                  <span class={`text-xs px-2 py-0.5 rounded border font-medium ${stageBadge[stage] ?? stageBadge.new}`}>
                    {stageLabel[stage] ?? stage}
                  </span>
                  <span class="text-xs px-2 py-0.5 rounded bg-card-2 border border-border text-gray-400">
                    {dealTypeLabel[dtype] ?? dtype} · {opValueLabel}
                  </span>
                  {hasActuals && <span class="text-xs text-gray-600">● actual</span>}
                </div>
                <!-- Economics strip -->
                <div class="flex items-center gap-5 mt-2 text-sm flex-wrap">
                  <span class="text-gray-500">
                    Spend: <span class="text-gray-300 font-mono">{hasActuals && deal.actual_spend != null ? fmt(deal.actual_spend) : fmt(deal.planned_spend)}</span>
                  </span>
                  {deal.buyer_fee > 0 && (
                    <span class="text-gray-500">
                      Buyer fee: <span class="text-gray-300 font-mono">{fmt(deal.buyer_fee)}</span>
                    </span>
                  )}
                  {deal.side_costs > 0 && (
                    <span class="text-gray-500">
                      Costs: <span class="text-gray-300 font-mono">{fmt(deal.side_costs)}</span>
                    </span>
                  )}
                  {acctFee > 0 && (
                    <span class="text-gray-500">
                      Accounts: <span class="text-gray-300 font-mono">{fmt(acctFee)}</span>
                      <span class="text-gray-700 text-xs ml-0.5">({deal.accounts_fee_pct}%)</span>
                    </span>
                  )}
                  {rev != null && (
                    <span class="text-gray-500">
                      Revenue: <span class="font-mono text-gray-300">{fmt(rev)}</span>
                    </span>
                  )}
                  {net != null && (
                    <span class={`font-semibold font-mono ${net >= 0 ? 'text-success' : 'text-danger'}`}>
                      Net: {net >= 0 ? '+' : ''}{fmt(net)}
                    </span>
                  )}
                </div>

                <!-- Agent: next touch, unanswered touches, pause -->
                <div class="deal-agent-strip flex items-center gap-4 mt-2 text-xs flex-wrap" data-id={deal.id}>
                  <span class="text-gray-500">Наступний дотик: <span class="agent-next text-gray-300 font-mono" data-at={agent.next_touch_at ?? ''}>—</span></span>
                  <span class="text-gray-500" title="Наші повідомлення після останньої відповіді партнера в прив'язаних чатах">
                    Дотиків без відповіді: <span class={`agent-unanswered font-mono ${agent.unanswered_touches > 0 ? 'text-warning' : 'text-gray-300'}`}>{agent.unanswered_touches ?? 0}</span>
                  </span>
                  <button type="button" class="agent-pause-btn px-2 py-0.5 rounded border transition-colors" data-id={deal.id} data-paused={agent.agent_paused ? 'true' : 'false'}></button>
                  {!agent.linked_chats && <span class="text-gray-700">чатів не прив'язано</span>}
                </div>

                <!-- Progress bar -->
                {!isFailed ? (
                  <div class="mt-3">
                    <div class="flex h-1.5 rounded-full overflow-hidden bg-card-2 gap-0.5">
                      {progressSteps.map((step, i) => (
                        <div class={`flex-1 transition-all ${i <= currentStep ? step.color : 'bg-card-2'}`}></div>
                      ))}
                    </div>
                    <div class="flex justify-between mt-1 text-[10px]">
                      {progressSteps.map((step, i) => (
                        <span class={`${i === currentStep ? 'text-gray-200 font-semibold' : i < currentStep ? 'text-gray-500' : 'text-gray-700'}`}>
                          {step.label}
                        </span>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class="mt-3 text-xs text-danger flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-danger inline-block"></span>
                    No Deal — partnership did not happen
                  </div>
                )}

                <!-- GEOs row -->
                {dealGeos.length > 0 && (
                  <div class="flex items-center gap-1.5 mt-2.5 flex-wrap">
                    <span class="text-[10px] text-gray-700 uppercase tracking-wide">GEO:</span>
                    {dealGeos.map((g: string) => (
                      <span class="text-[10px] font-mono bg-card-2 border border-border px-1.5 py-0.5 rounded text-gray-400 leading-none">{g}</span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Stage change -->
              <form method="POST" class="flex items-center gap-1 shrink-0">
                <input type="hidden" name="_action" value="update_stage" />
                <input type="hidden" name="deal_id" value={deal.id} />
                <select name="stage" onchange="this.form.submit()"
                  class="bg-card-2 border border-border rounded-lg px-2 py-1.5 text-xs text-gray-300 focus:border-accent outline-none">
                  {[
                    ['new','New'],['negotiation','Negotiation'],['trial','Trial'],
                    ['active','Active'],['completed','Completed'],['no_deal','No Deal']
                  ].map(([val, label]) => (
                    <option value={val} selected={val === stage}>{stageLabel[val] ?? label}</option>
                  ))}
                </select>
              </form>

              <!-- Toggle expand -->
              <button class="expand-btn text-gray-600 hover:text-gray-300 text-lg transition-colors shrink-0" data-id={deal.id}>
                ⌄
              </button>
            </div>

            <!-- Expandable: details (actuals, files, reports) | conversation -->
            <div id={`expand-${deal.id}`} class="hidden border-t border-border p-5">
              <div class="flex gap-1 mb-4 border-b border-border/50">
                <button type="button" class="deal-tab text-sm px-3 py-1.5 -mb-px border-b-2 border-accent text-gray-100" data-deal={deal.id} data-tab="details">Деталі</button>
                <button type="button" class="deal-tab text-sm px-3 py-1.5 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-300" data-deal={deal.id} data-tab="conversation">Розмова</button>
              </div>

              <div class="deal-tab-panel" data-deal={deal.id} data-tab="conversation" hidden>
                <div class="conv-chats text-xs text-gray-500 mb-3"></div>
                <div class="conv-list max-h-[520px] overflow-y-auto space-y-2 pr-1"></div>
                <p class="conv-status text-[11px] text-gray-700 mt-2"></p>
              </div>

              <div class="deal-tab-panel" data-deal={deal.id} data-tab="details">
              <!-- Agent: next touch -->
              <div class="flex items-end gap-3 mb-4 pb-4 border-b border-border/40 flex-wrap">
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Наступний дотик</label>
                  <input type="datetime-local" class="agent-next-input bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" data-id={deal.id} data-at={agent.next_touch_at ?? ''} />
