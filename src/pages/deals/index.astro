                <button type="button" class="agent-next-save bg-card-2 hover:bg-accent hover:text-white border border-border text-sm text-gray-300 px-3 py-1.5 rounded-lg transition-colors" data-id={deal.id}>Зберегти</button>
                <button type="button" class="agent-next-clear text-xs text-gray-500 hover:text-gray-300 px-2 py-1.5" data-id={deal.id}>Очистити</button>
              </div>
              <!-- Delete form lives outside the actuals form to avoid nesting -->
              <form method="POST" id={`delete-form-${deal.id}`}>
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="deal_id" value={deal.id} />
