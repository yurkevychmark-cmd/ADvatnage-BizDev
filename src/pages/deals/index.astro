              <form method="POST" class="grid grid-cols-2 gap-4">
                <input type="hidden" name="_action" value="update_actuals" />
                <input type="hidden" name="deal_id" value={deal.id} />

                <!-- Deal model (editable) -->
                <div class="col-span-2 mb-1">
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Deal Model</p>
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Deal Type</label>
                  <select name="deal_type" class={`edit-deal-type-select w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none`} data-current={dtype}>
                    <option value="CPA"      selected={dtype === 'CPA'}>CPA (per conversion)</option>
                    <option value="RevShare" selected={dtype === 'RevShare'}>RevShare (% of revenue)</option>
