                <div>
                  <label class="block text-xs text-gray-500 mb-1 edit-op-value-label">
                    {dtype === 'CPA' ? 'CPA Value ($)' : dtype === 'RevShare' ? 'RevShare %' : 'Spend %'}
                  </label>
                  <input type="number" name="op_value" step="0.01" min="0" value={opValue ?? ''}
                    class="w-full bg-card-2 border border-border rounded-lg px-3 py-1.5 text-sm text-gray-200 focus:border-accent outline-none" />
