---
import Layout from '../../components/Layout.astro';
import GeoTag from '../../components/GeoTag.astro';
import TrafficTag from '../../components/TrafficTag.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import { supabase } from '../../lib/supabase';
import type { Buyer } from '../../lib/types';

const { data: buyers } = await supabase
  .from('buyers')
  .select('*')
  .order('sort_order', { ascending: true, nullsFirst: false })
  .order('created_at', { ascending: false });

const buyersJson = JSON.stringify(buyers ?? []);
---

<Layout title="Buyers">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Buyers</h1>
      <p class="text-gray-500 text-sm mt-1">Media buyers in your network</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="export-csv" class="text-sm text-gray-400 hover:text-gray-200 border border-border px-4 py-2 rounded-lg bg-card-2 transition-colors">
        ↓ Export CSV
      </button>
      <a href="/buyers/add" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
        + Add Buyer
      </a>
    </div>
  </div>

  <!-- Filter bar -->
  <div class="flex flex-wrap gap-3 mb-6">
    <input id="search" type="text" placeholder="Search by name or contact…"
      class="flex-1 min-w-48 bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
    <input id="filter-geo" type="text" placeholder="Filter by GEO (e.g. DE)"
      class="w-40 bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-200 placeholder-gray-600 focus:border-accent outline-none" />
    <select id="filter-traffic" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">All traffic types</option>
      <option>Meta Ads</option>
      <option>InApp</option>
      <option>DSP</option>
      <option>Google Ads</option>
      <option>TikTok Ads</option>
    </select>
    <select id="filter-type" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">All types</option>
      <option value="EXTERNAL">External</option>
      <option value="INTERNAL">Internal</option>
    </select>
    <select id="filter-rating" class="bg-card border border-border rounded-lg px-4 py-2 text-sm text-gray-300 focus:border-accent outline-none">
      <option value="">Any rating</option>
      <option value="8">8+ (Top)</option>
      <option value="5">5+ (Good)</option>
      <option value="1">Rated</option>
    </select>
    <span id="count" class="self-center text-xs text-gray-600 font-mono"></span>
  </div>

  {(!buyers || buyers.length === 0) ? (
    <div class="bg-card rounded-xl border border-border p-12 text-center">
      <p class="text-gray-500">No buyers yet.</p>
      <a href="/buyers/add" class="text-accent hover:underline text-sm mt-2 inline-block">Add your first buyer</a>
    </div>
  ) : (
    <div id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {(buyers as Buyer[]).map(buyer => {
        const bAny = buyer as any;
        const workedWith = bAny.worked_with === true;
        return (
          <div
            class="buyer-card bg-card rounded-xl border border-border hover:border-accent/40 transition-all group relative overflow-hidden cursor-pointer"
            draggable="true"
            data-id={buyer.id}
            data-name={`${buyer.name} ${buyer.contact_name ?? ''}`.toLowerCase()}
            data-geo={(buyer.geo_expertise ?? []).join(' ').toLowerCase()}
            data-traffic={(buyer.traffic_types ?? []).join(' ').toLowerCase()}
            data-rating={buyer.rating ?? ''}
            data-type={bAny.type ?? 'EXTERNAL'}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

            <!-- Drag handle -->
            <div class="drag-handle absolute top-3 left-3 text-gray-700 group-hover:text-gray-500 cursor-grab select-none z-10 opacity-0 group-hover:opacity-100 transition-opacity text-lg leading-none" title="Drag to reorder">⠿</div>

            <!-- Worked-with toggle button -->
            <button
              class={`worked-btn absolute top-3 right-3 z-10 flex items-center gap-1 text-xs px-2 py-1 rounded-full border transition-all ${
                workedWith
                  ? 'bg-success/15 text-success border-success/30 hover:bg-success/25'
                  : 'bg-card-2 text-gray-600 border-border hover:text-gray-400 hover:border-gray-500'
              }`}
              data-id={buyer.id}
              data-worked={workedWith ? '1' : '0'}
              title={workedWith ? 'Mark as not worked with' : 'Mark as worked with'}
            >
              {workedWith ? '✓ Worked' : '○ Not worked'}
            </button>

            <!-- Main clickable area → edit page -->
            <a href={`/buyers/${buyer.id}`} class="block p-6 pt-10">
              <div class="flex items-start justify-between mb-2">
                <div class="flex-1 min-w-0 pr-2">
                  <h3 class="font-semibold group-hover:text-accent transition-colors truncate">{buyer.name}</h3>
                  {buyer.contact_name && <p class="text-gray-500 text-xs mt-0.5">{buyer.contact_name}</p>}
                </div>
                <span class="text-xs font-mono bg-card-2 border border-border px-2 py-1 rounded text-gray-400 shrink-0">
                  ${Number(buyer.monthly_budget_capacity || 0).toLocaleString()}
                </span>
              </div>

              <!-- Type badge -->
              <div class="mb-3">
                <span class={`inline-block text-xs font-medium px-2 py-0.5 rounded border ${
                  bAny.type === 'INTERNAL'
                    ? 'bg-blue-500/10 text-blue-400 border-blue-500/20'
                    : 'bg-gray-500/10 text-gray-400 border-gray-500/20'
                }`}>
                  {bAny.type === 'INTERNAL' ? 'Internal' : 'External'}
                </span>
              </div>

              {buyer.rating != null && (
                <div class="mb-3">
                  <RatingBadge rating={buyer.rating} />
                </div>
              )}

              <div class="flex flex-wrap gap-1 mb-2">
                {(buyer.geo_expertise ?? []).map(g => <GeoTag code={g} />)}
                {(buyer.geo_expertise ?? []).length === 0 && <span class="text-gray-700 text-xs italic">No GEOs set</span>}
              </div>
              <div class="flex flex-wrap gap-1">
                {(buyer.traffic_types ?? []).map(t => <TrafficTag type={t} />)}
              </div>
            </a>
          </div>
        );
      })}
    </div>
  )}

  <div id="empty-filter" class="hidden bg-card rounded-xl border border-border p-12 text-center">
    <p class="text-gray-500">No buyers match your filters.</p>
  </div>
</Layout>

<script define:vars={{ buyersJson }}>
  const buyers = JSON.parse(buyersJson);
  const grid = document.getElementById('grid');
  const cards = () => [...document.querySelectorAll('.buyer-card')];
  const emptyFilter = document.getElementById('empty-filter');
  const countEl = document.getElementById('count');

  // ── Filters ──────────────────────────────────────────────────────────
  function applyFilters() {
    const search = document.getElementById('search').value.toLowerCase();
    const geo = document.getElementById('filter-geo').value.toLowerCase();
    const traffic = document.getElementById('filter-traffic').value.toLowerCase();
    const ratingMin = Number(document.getElementById('filter-rating').value) || 0;
    const typeFilter = document.getElementById('filter-type').value;

    let visible = 0;
    cards().forEach(card => {
      const ok =
        (!search || (card.dataset.name ?? '').includes(search)) &&
        (!geo || (card.dataset.geo ?? '').includes(geo)) &&
        (!traffic || (card.dataset.traffic ?? '').includes(traffic)) &&
        (!ratingMin || Number(card.dataset.rating) >= ratingMin) &&
        (!typeFilter || card.dataset.type === typeFilter);
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    countEl.textContent = `${visible} of ${cards().length}`;
    emptyFilter.classList.toggle('hidden', visible > 0);
  }

  ['search', 'filter-geo', 'filter-traffic', 'filter-rating', 'filter-type'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', applyFilters);
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });
  applyFilters();

  // ── Worked-with toggle ────────────────────────────────────────────────
  document.querySelectorAll('.worked-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = btn.dataset.id;
      const newWorked = btn.dataset.worked !== '1';
      btn.dataset.worked = newWorked ? '1' : '0';
      // Update appearance immediately
      if (newWorked) {
        btn.className = btn.className
          .replace('bg-card-2 text-gray-600 border-border hover:text-gray-400 hover:border-gray-500', '')
          + ' bg-success/15 text-success border-success/30 hover:bg-success/25';
        btn.textContent = '✓ Worked';
        btn.title = 'Mark as not worked with';
      } else {
        btn.className = btn.className
          .replace('bg-success/15 text-success border-success/30 hover:bg-success/25', '')
          + ' bg-card-2 text-gray-600 border-border hover:text-gray-400 hover:border-gray-500';
        btn.textContent = '○ Not worked';
        btn.title = 'Mark as worked with';
      }
      await fetch('/api/toggle-worked', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, worked_with: newWorked }),
      });
    });
  });

  // ── Drag and drop ─────────────────────────────────────────────────────
  let dragSrc = null;

  if (grid) {
    grid.addEventListener('dragstart', e => {
      const card = e.target.closest('.buyer-card');
      if (!card) return;
      dragSrc = card;
      card.style.opacity = '0.4';
      e.dataTransfer.effectAllowed = 'move';
    });

    grid.addEventListener('dragend', e => {
      const card = e.target.closest('.buyer-card');
      if (card) card.style.opacity = '';
      dragSrc = null;
      document.querySelectorAll('.buyer-card').forEach(c => c.classList.remove('ring-2', 'ring-accent'));
    });

    grid.addEventListener('dragover', e => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const card = e.target.closest('.buyer-card');
      document.querySelectorAll('.buyer-card').forEach(c => c.classList.remove('ring-2', 'ring-accent'));
      if (card && card !== dragSrc) card.classList.add('ring-2', 'ring-accent');
    });

    grid.addEventListener('drop', e => {
      e.preventDefault();
      const target = e.target.closest('.buyer-card');
      if (!target || target === dragSrc || !dragSrc) return;
      document.querySelectorAll('.buyer-card').forEach(c => c.classList.remove('ring-2', 'ring-accent'));

      // Determine insert position: before or after target
      const rect = target.getBoundingClientRect();
      const mid = rect.left + rect.width / 2;
      if (e.clientX < mid) {
        grid.insertBefore(dragSrc, target);
      } else {
        grid.insertBefore(dragSrc, target.nextSibling);
      }
      saveOrder();
    });
  }

  function saveOrder() {
    const ids = cards().map(c => c.dataset.id).filter(Boolean);
    fetch('/api/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ table: 'buyers', ids }),
    });
  }

  // ── CSV export ────────────────────────────────────────────────────────
  document.getElementById('export-csv')?.addEventListener('click', () => {
    const headers = ['Name','Type','Worked With','Contact','Email','Telegram','GEOs','Traffic Types','Budget','Rating','Notes'];
    const rows = buyers.map(b => [
      b.name, b.type ?? 'EXTERNAL', b.worked_with ? 'Yes' : 'No',
      b.contact_name ?? '', b.contact_email ?? '', b.contact_telegram ?? '',
      (b.geo_expertise ?? []).join(';'), (b.traffic_types ?? []).join(';'),
      b.monthly_budget_capacity ?? '', b.rating ?? '',
      (b.notes ?? '').replace(/\n/g, ' '),
    ]);
    const csv = [headers, ...rows].map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = 'buyers.csv';
    a.click();
  });
</script>
