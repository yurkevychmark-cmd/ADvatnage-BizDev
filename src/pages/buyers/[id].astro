---
import Layout from '../../components/Layout.astro';
import { supabase } from '../../lib/supabase';
import type { Buyer } from '../../lib/types';

const { id } = Astro.params;
const trafficOptions = ['Meta Ads', 'InApp', 'DSP', 'Google Ads', 'TikTok Ads'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  if (action === 'delete') {
    await supabase.from('buyers').delete().eq('id', id!);
    return Astro.redirect('/buyers');
  }
  const geoRaw = (form.get('geo_expertise') as string) || '';
  const geo = geoRaw.split(',').map(g => g.trim().toUpperCase()).filter(Boolean);
  const traffic = trafficOptions.filter(t => form.get(`traffic_${t}`));
  const ratingRaw = form.get('rating') as string;
  await supabase.from('buyers').update({
    name: form.get('name') as string,
    contact_name: (form.get('contact_name') as string) || null,
    contact_email: (form.get('contact_email') as string) || null,
    contact_telegram: (form.get('contact_telegram') as string) || null,
    geo_expertise: geo,
    traffic_types: traffic,
    monthly_budget_capacity: Number(form.get('monthly_budget_capacity')) || 0,
    rating: ratingRaw ? Number(ratingRaw) : null,
    notes: (form.get('notes') as string) || null,
  }).eq('id', id!);
  return Astro.redirect('/buyers');
}

const { data: buyer } = await supabase.from('buyers').select('*').eq('id', id!).single();
if (!buyer) return Astro.redirect('/buyers');
const b = buyer as Buyer;

const inputCls = "w-full bg-card-2 border border-border rounded-lg px-4 py-2 text-gray-100 focus:border-accent focus:ring-1 focus:ring-accent outline-none placeholder-gray-600 transition-colors";
---

<Layout title={`Edit ${b.name}`}>
  <div class="mb-8">
    <a href="/buyers" class="text-gray-600 hover:text-gray-300 text-sm transition-colors">&larr; Back to Buyers</a>
    <h1 class="text-2xl font-bold mt-2">{b.name}</h1>
    <p class="text-gray-600 text-xs mt-1">Created {new Date(b.created_at).toLocaleDateString()}</p>
  </div>

  <form method="POST" class="bg-card rounded-xl border border-border p-6 max-w-2xl space-y-5">
    <div>
      <label class="block text-sm text-gray-400 mb-1">Name *</label>
      <input type="text" name="name" required value={b.name} class={inputCls} />
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Contact Name</label>
        <input type="text" name="contact_name" value={b.contact_name || ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Email</label>
        <input type="email" name="contact_email" value={b.contact_email || ''} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Telegram</label>
        <input type="text" name="contact_telegram" value={b.contact_telegram || ''} class={inputCls} />
      </div>
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-1">GEO Expertise <span class="text-gray-600">(comma-separated)</span></label>
      <input type="text" name="geo_expertise" value={(b.geo_expertise ?? []).join(', ')} class={inputCls} />
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-2">Traffic Types</label>
      <div class="flex flex-wrap gap-3">
        {trafficOptions.map(t => (
          <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer group">
            <input type="checkbox" name={`traffic_${t}`} checked={(b.traffic_types ?? []).includes(t)}
              class="rounded bg-card-2 border-border text-accent focus:ring-accent focus:ring-offset-0" />
            <span class="group-hover:text-accent transition-colors">{t}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-gray-400 mb-1">Monthly Budget Capacity (USD)</label>
        <input type="number" name="monthly_budget_capacity" step="0.01" min="0" value={b.monthly_budget_capacity} class={inputCls} />
      </div>
      <div>
        <label class="block text-sm text-gray-400 mb-1">Rating <span class="text-gray-600">(1–10)</span></label>
        <input type="number" name="rating" id="rating_input" min="1" max="10" value={b.rating ?? ''} placeholder="e.g. 8" class={inputCls} />
        <div class="flex gap-0.5 mt-2" id="rating_dots">
          {Array.from({ length: 10 }, (_, i) => (
            <span class={`w-2 h-2 rounded-full rating-dot transition-colors ${
              b.rating != null && i < b.rating
                ? b.rating >= 8 ? 'bg-success' : b.rating >= 5 ? 'bg-warning' : 'bg-danger'
                : 'bg-gray-700'
            }`} data-index={i + 1}></span>
          ))}
        </div>
      </div>
    </div>

    <div>
      <label class="block text-sm text-gray-400 mb-1">Notes</label>
      <textarea name="notes" rows="3" class={`${inputCls} resize-none`}>{b.notes || ''}</textarea>
    </div>

    <div class="flex items-center justify-between pt-2">
      <button type="submit" class="bg-accent hover:bg-accent-dark text-white font-medium px-6 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
        Save Changes
      </button>
      <button type="submit" name="_action" value="delete"
        onclick="return confirm('Delete this buyer?')"
        class="bg-danger/10 text-danger hover:bg-danger/20 border border-danger/20 rounded-lg px-4 py-2.5 text-sm transition-colors">
        Delete Buyer
      </button>
    </div>
  </form>
</Layout>

<script>
  const input = document.getElementById('rating_input') as HTMLInputElement;
  const dots = document.querySelectorAll('.rating-dot');

  function updateDots(val: number) {
    dots.forEach((dot, i) => {
      const el = dot as HTMLElement;
      el.className = `w-2 h-2 rounded-full rating-dot transition-colors ${
        i < val ? (val >= 8 ? 'bg-success' : val >= 5 ? 'bg-warning' : 'bg-danger') : 'bg-gray-700'
      }`;
    });
  }

  input?.addEventListener('input', () => updateDots(Number(input.value)));
  dots.forEach((dot, i) => {
    (dot as HTMLElement).style.cursor = 'pointer';
    dot.addEventListener('click', () => {
      input.value = String(i + 1);
      updateDots(i + 1);
    });
  });
</script>
