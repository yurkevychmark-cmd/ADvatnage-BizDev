---
import Layout from '../components/Layout.astro';
import StatCard from '../components/StatCard.astro';
import ScoreBadge from '../components/ScoreBadge.astro';
import GeoTag from '../components/GeoTag.astro';
import { supabase } from '../lib/supabase';

const { count: buyerCount } = await supabase.from('buyers').select('*', { count: 'exact', head: true });
const { count: operatorCount } = await supabase.from('operators').select('*', { count: 'exact', head: true });
const { count: matchCount } = await supabase.from('matches').select('*', { count: 'exact', head: true });
const { count: projectCount } = await supabase.from('projects').select('*', { count: 'exact', head: true });

const { data: recentMatches } = await supabase
  .from('matches')
  .select('*, buyer:buyers(*), operator:operators(*)')
  .order('score', { ascending: false })
  .limit(5);

const { data: recentProjects } = await supabase
  .from('projects')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);
---

<Layout title="Dashboard">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Dashboard</h1>
    <p class="text-gray-500 text-sm mt-1">Overview of your matchmaking pipeline</p>
  </div>

  <div class="grid grid-cols-4 gap-4 mb-8">
    <StatCard label="Buyers" value={buyerCount ?? 0} />
    <StatCard label="Operators" value={operatorCount ?? 0} />
    <StatCard label="Matches" value={matchCount ?? 0} />
    <StatCard label="Projects" value={projectCount ?? 0} />
  </div>

  <div class="flex gap-4 mb-8">
    <a href="/buyers/add" class="bg-accent hover:bg-indigo-600 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">+ Add Buyer</a>
    <a href="/operators/add" class="bg-accent hover:bg-indigo-600 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">+ Add Operator</a>
    <a href="/matchmaking" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">Run Matchmaking</a>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div class="bg-card rounded-xl border border-gray-800 p-6">
      <h2 class="text-lg font-semibold mb-4">Top Matches</h2>
      {(!recentMatches || recentMatches.length === 0) ? (
        <p class="text-gray-500 text-sm">No matches yet. Add buyers and operators, then run matchmaking.</p>
      ) : (
        <div class="space-y-3">
          {recentMatches.map((m: any) => (
            <div class="flex items-center justify-between p-3 bg-gray-800/30 rounded-lg">
              <div>
                <span class="font-medium text-sm">{m.buyer?.name}</span>
                <span class="text-gray-500 mx-2">↔</span>
                <span class="font-medium text-sm">{m.operator?.name}</span>
                <div class="flex gap-1 mt-1">
                  {m.geo_overlap?.map((g: string) => <GeoTag code={g} />)}
                </div>
              </div>
              <ScoreBadge score={m.score} />
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="bg-card rounded-xl border border-gray-800 p-6">
      <h2 class="text-lg font-semibold mb-4">Recent Projects</h2>
      {(!recentProjects || recentProjects.length === 0) ? (
        <p class="text-gray-500 text-sm">No projects yet. Use the calculator to create one.</p>
      ) : (
        <table class="w-full text-sm">
          <thead>
            <tr class="text-gray-500 text-xs uppercase">
              <th class="text-left pb-2">Name</th>
              <th class="text-left pb-2">Status</th>
              <th class="text-right pb-2">ROI</th>
            </tr>
          </thead>
          <tbody>
            {recentProjects.map((p: any) => (
              <tr class="border-t border-gray-800">
                <td class="py-2">{p.name}</td>
                <td class="py-2">
                  <span class={`text-xs px-2 py-0.5 rounded-full ${
                    p.status === 'active' ? 'bg-success/20 text-success' :
                    p.status === 'completed' ? 'bg-accent/20 text-accent' :
                    'bg-gray-700 text-gray-400'
                  }`}>{p.status}</span>
                </td>
                <td class="py-2 text-right font-mono">{p.calc_roi != null ? `${p.calc_roi}%` : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</Layout>
