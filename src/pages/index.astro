---
import Layout from '../components/Layout.astro';
import StatCard from '../components/StatCard.astro';
import { supabase } from '../lib/supabase';

const { count: buyerCount } = await supabase.from('buyers').select('*', { count: 'exact', head: true });
const { count: operatorCount } = await supabase.from('operators').select('*', { count: 'exact', head: true });
const { count: dealCount } = await supabase.from('projects').select('*', { count: 'exact', head: true });

// All deals for stage + GEO + spend aggregation
const { data: allDeals } = await supabase
  .from('projects')
  .select('id, pipeline_stage, planned_spend, actual_spend, geos, created_at, buyer:buyers(name), operator:operators(name)')
  .order('created_at', { ascending: false });

const dealsArr = (allDeals ?? []) as any[];

// Active = trial or active
const activeDeals = dealsArr.filter(d => ['trial', 'active'].includes(d.pipeline_stage));
const totalSpendPlanned = dealsArr.reduce((s, d) => s + (Number(d.planned_spend) || 0), 0);
const totalSpendActual  = dealsArr.reduce((s, d) => s + (Number(d.actual_spend ?? 0) || 0), 0);

// Spend this month
const now = new Date();
const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
const monthSpend = dealsArr
  .filter(d => new Date(d.created_at) >= monthStart)
  .reduce((s, d) => s + (Number(d.actual_spend ?? d.planned_spend ?? 0) || 0), 0);

// GEO breakdown — count active deals per GEO
const geoCount: Record<string, number> = {};
activeDeals.forEach(d => {
  (d.geos ?? []).forEach((g: string) => {
    geoCount[g] = (geoCount[g] ?? 0) + 1;
  });
});
const topGeos = Object.entries(geoCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

// Stage breakdown
const stageBreakdown: Record<string, number> = {};
dealsArr.forEach(d => {
  const s = d.pipeline_stage ?? 'new';
  stageBreakdown[s] = (stageBreakdown[s] ?? 0) + 1;
});

const stageLabel: Record<string, string> = {
  new: 'Новий', negotiation: 'Переговори', trial: 'Тестовий',
  active: 'Ретеншин', completed: 'Завершено', no_deal: 'Не домовились',
};
const stageBadge: Record<string, string> = {
  new:         'bg-gray-700/60 text-gray-300 border-gray-600',
  negotiation: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/25',
  trial:       'bg-purple-500/15 text-purple-400 border-purple-500/25',
  active:      'bg-green-500/15 text-green-400 border-green-500/25',
  completed:   'bg-blue-500/15 text-blue-400 border-blue-500/25',
  no_deal:     'bg-red-500/15 text-red-400 border-red-500/25',
};

const recentDeals = dealsArr.slice(0, 5);

const { data: recentActivity } = await supabase
  .from('activity_log')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(6);

const entityIcon: Record<string, string> = { buyer: '⊕', operator: '⊛', deal: '⇋' };

function fmtUSD(n: number) {
  if (n >= 1_000_000) return '$' + (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return '$' + (n / 1_000).toFixed(1) + 'K';
  return '$' + Math.round(n).toLocaleString();
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return `${m}m`;
  if (m < 1440) return `${Math.floor(m / 60)}h`;
  return `${Math.floor(m / 1440)}d`;
}
---

<Layout title="Dashboard">
  <div class="mb-8">
    <h1 class="text-2xl font-bold">Dashboard</h1>
    <p class="text-gray-600 text-sm mt-1">Overview of your deals pipeline</p>
  </div>

  <!-- Top stat cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <StatCard label="Buyers" value={buyerCount ?? 0} />
    <StatCard label="Operators" value={operatorCount ?? 0} />
    <StatCard label="Active Deals" value={activeDeals.length} />
    <StatCard label="This Month Spend" value={fmtUSD(monthSpend)} />
  </div>

  <!-- Spend overview + Stage breakdown -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <!-- Total spend -->
    <div class="bg-card rounded-xl border border-border p-5 md:col-span-1">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Total Spend</p>
      <div class="space-y-2">
        <div class="flex items-baseline justify-between">
          <span class="text-xs text-gray-600">Planned</span>
          <span class="text-lg font-mono text-gray-300">{fmtUSD(totalSpendPlanned)}</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-xs text-gray-600">Actual</span>
          <span class="text-2xl font-mono font-bold text-success">{fmtUSD(totalSpendActual)}</span>
        </div>
        <div class="h-1.5 rounded-full bg-card-2 overflow-hidden mt-2">
          <div class="h-full bg-success transition-all" style={`width: ${totalSpendPlanned > 0 ? Math.min(100, (totalSpendActual / totalSpendPlanned) * 100) : 0}%`}></div>
        </div>
      </div>
    </div>

    <!-- Stage breakdown -->
    <div class="bg-card rounded-xl border border-border p-5 md:col-span-2">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Deals by Stage</p>
      <div class="flex flex-wrap gap-2">
        {Object.entries(stageBreakdown).map(([s, c]) => (
          <a href={`/deals?stage=${s}`} class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm transition-all hover:scale-105 ${stageBadge[s] ?? stageBadge.new}`}>
            <span class="font-medium">{stageLabel[s] ?? s}</span>
            <span class="font-mono font-bold">{c}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Top GEOs -->
  {topGeos.length > 0 && (
    <div class="bg-card rounded-xl border border-border p-5 mb-8">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-3">Active Deals by GEO</p>
      <div class="flex flex-wrap gap-2">
        {topGeos.map(([geo, count]) => (
          <div class="inline-flex items-center gap-2 bg-card-2 border border-border px-3 py-1.5 rounded-lg">
            <span class="font-mono text-sm text-gray-200 font-bold">{geo}</span>
            <span class="text-xs text-gray-500">{count} {count === 1 ? 'deal' : 'deals'}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Quick actions -->
  <div class="flex flex-wrap gap-3 mb-8">
    <a href="/buyers/add" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
      + Add Buyer
    </a>
    <a href="/operators/add" class="bg-accent hover:bg-accent-dark text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors shadow-lg shadow-accent/20">
      + Add Operator
    </a>
    <a href="/deals" class="bg-card-2 hover:bg-border text-gray-300 hover:text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors border border-border">
      View Deals
    </a>
    <a href="/tasks" class="bg-card-2 hover:bg-border text-gray-300 hover:text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors border border-border">
      View Tasks
    </a>
  </div>

  <!-- Recent Deals + Activity -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-card rounded-xl border border-border p-6">
      <h2 class="text-base font-semibold mb-4 flex items-center gap-2">
        <span class="w-1.5 h-4 bg-accent rounded-full inline-block"></span>
        Recent Deals
      </h2>
      {recentDeals.length === 0 ? (
        <p class="text-gray-600 text-sm">No deals yet.</p>
      ) : (
        <div class="space-y-1">
          {recentDeals.map((d: any) => {
            const s = d.pipeline_stage ?? 'new';
            return (
              <a href="/deals" class="flex items-center justify-between py-2.5 border-b border-border/40 last:border-0 hover:bg-card-2/40 -mx-2 px-2 rounded transition-colors group">
                <p class="text-sm text-gray-200 truncate flex-1">
                  {d.buyer?.name ?? '—'}
                  <span class="text-gray-600 mx-1.5">↔</span>
                  {d.operator?.name ?? '—'}
                </p>
                <span class={`text-xs px-2 py-0.5 rounded border font-medium shrink-0 ml-3 ${stageBadge[s] ?? stageBadge.new}`}>
                  {stageLabel[s] ?? s}
                </span>
              </a>
            );
          })}
        </div>
      )}
    </div>

    <div class="bg-card rounded-xl border border-border p-6">
      <h2 class="text-base font-semibold mb-4 flex items-center gap-2">
        <span class="w-1.5 h-4 bg-accent rounded-full inline-block"></span>
        Recent Activity
      </h2>
      {(!recentActivity || recentActivity.length === 0) ? (
        <p class="text-gray-600 text-sm">No activity yet.</p>
      ) : (
        <div class="space-y-0">
          {(recentActivity as any[]).map(entry => (
            <div class="flex items-center gap-3 py-2.5 border-b border-border/40 last:border-0">
              <span class="text-gray-600 text-sm shrink-0 w-4">{entityIcon[entry.entity_type] ?? '·'}</span>
              <p class="text-sm text-gray-300 truncate flex-1">{entry.entity_name}</p>
              <span class="text-xs text-gray-500 shrink-0">{entry.action}</span>
              <span class="text-xs text-gray-700 shrink-0 w-10 text-right">{timeAgo(entry.created_at)}</span>
            </div>
          ))}
        </div>
      )}
      <a href="/log" class="block mt-3 text-xs text-gray-600 hover:text-accent transition-colors">View full journal →</a>
    </div>
  </div>
</Layout>
